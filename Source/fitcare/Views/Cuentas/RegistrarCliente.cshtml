@model AgregarClienteViewModel

@{
	ViewBag.Title = "Clientes";
}

<div class="container">
	<div class="row">
		<div class="col-5 align-self-center">
			<h6 class="page-title">Registrar cliente</h6>
		</div>
		<div class="col-7 align-self-center">
			<div class="d-flex align-items-center justify-content-end">
				<nav aria-label="breadcrumb">
					<ol class="breadcrumb">
						<li class="breadcrumb-item">
							<a asp-action="Admin" asp-controller="Home">Administración</a>
						</li>
						<li class="breadcrumb-item active" aria-current="page">
							Registrar cliente
						</li>
					</ol>
				</nav>
			</div>
		</div>
	</div>

	<div class="row">
		<div class="col-12">
			<div class="card shadow-sm">
				<div class="card-body">
					<form asp-action="RegistrarCliente" asp-controller="Cuentas" method="post" autocomplete="off" enctype="multipart/form-data">
						<input asp-for="IdUsuario" type="hidden" />

						<div class="row">
							<div class="col-md-12">
								<div asp-validation-summary="ModelOnly"></div>
							</div>
						</div>

						<div class="row">
							<div class="col-md-12">
								<p>Registrar a <strong>@Model.Nombre</strong> (@Model.Correo) como cliente</p>
							</div>

							<div class="col-sm-12 col-md-4">
								<div class="form-group">
									<label asp-for="IdProvincia"></label>
									<select asp-for="IdProvincia" asp-items="@(new SelectList(ViewBag.Provincias, "Value", "Text"))" class="form-control form-control-sm" id="selectProvincia">
										<option value="">Seleccione una provincia</option>
									</select>
									<span asp-validation-for="IdProvincia"></span>
								</div>
							</div>

							<div class="col-sm-12 col-md-4">
								<div class="form-group">
									<label asp-for="IdCanton"></label>
									<select asp-for="IdCanton" class="form-control form-control-sm" id="selectCanton" disabled>
										<option value="">Seleccione primero una provincia</option>
									</select>
									<span asp-validation-for="IdCanton"></span>
								</div>
							</div>

							<div class="col-sm-12 col-md-4">
								<div class="form-group">
									<label asp-for="IdDistrito"></label>
									<select asp-for="IdDistrito" class="form-control form-control-sm" id="selectDistrito" disabled>
										<option value="">Seleccione primero un cantón</option>
									</select>
									<span asp-validation-for="IdDistrito"></span>
								</div>
							</div>

							<div class="col-sm-12 col-md-4">
								<div class="form-group">
									<label asp-for="IdPlanMembresia"></label>
									<select asp-for="IdPlanMembresia" class="form-control form-control-sm" id="selectPlanMembresia">
										<option value="">Seleccione un plan</option>
										@foreach (var plan in (IList<SelectListItemWithData>)ViewBag.PlanesMembresia)
										{
											<option value="@plan.Value" data-meses="@plan.Meses">@plan.Text</option>
										}
									</select>
									<span asp-validation-for="IdPlanMembresia" class="text-danger"></span>
								</div>
							</div>

							<div class="col-sm-12 col-md-4">
								<div class="form-group">
									<label asp-for="FechaInscripcion"></label>
									<br />
									<input asp-for="FechaInscripcion" class="form-control form-control-sm" id="inputFechaInscripcion" />
									<span asp-validation-for="FechaInscripcion" class="text-danger"></span>
								</div>
							</div>

							<div class="col-sm-12 col-md-4">
								<div class="form-group">
									<label asp-for="FechaRenovacion"></label>
									<br />
									<input asp-for="FechaRenovacion" class="form-control form-control-sm" id="inputFechaRenovacion" readonly />
									<small class="text-muted">Calculada automáticamente</small>
								</div>
							</div>

							<div class="col-12">
								<button type="submit" class="btn btn-sm btn-primary">Guardar</button>
								<a asp-action="RegistrarNuevoCliente" class="btn btn-sm btn-secondary">Regresar</a>
							</div>
						</div>
					</form>
				</div>
			</div>
		</div>
	</div>
</div>

@section Scripts{
	<partial name="_ValidationScriptsPartial" />

	<script type="text/javascript">
		$(document).ready(function () {
			initCascadingDropdowns({
				provinciaSelector: '#selectProvincia',
				cantonSelector: '#selectCanton',
				distritoSelector: '#selectDistrito',
				cantonesUrl: '@Url.Action("ObtenerCantonesPorProvincia", "Cuentas")',
				distritosUrl: '@Url.Action("ObtenerDistritosPorCanton", "Cuentas")'
			});

			// Calcular fecha de renovación al cambiar plan o fecha de inscripción
			$('#selectPlanMembresia, #inputFechaInscripcion').on('change', function() {
				calcularFechaRenovacion();
			});

			function calcularFechaRenovacion() {
				var fechaInscripcion = $('#inputFechaInscripcion').val();
				var mesesPlan = $('#selectPlanMembresia option:selected').data('meses');

				if (fechaInscripcion && mesesPlan) {
					var fecha = new Date(fechaInscripcion);
					fecha.setMonth(fecha.getMonth() + mesesPlan);
					var fechaFormateada = fecha.toISOString().split('T')[0];
					$('#inputFechaRenovacion').val(fechaFormateada);
				}
			}

			// Calcular al cargar si ya hay valores
			calcularFechaRenovacion();
		});
	</script>
}

@model AgregarUsuarioViewModel

@{
    ViewBag.Title = "Usuario";
}

<div class="container">
    <div class="row">
        <div class="col-5 align-self-center">
            <h6 class="page-title">Agregar usuario</h6>
        </div>
        <div class="col-7 align-self-center">
            <div class="d-flex align-items-center justify-content-end">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item">
                            <a asp-action="Admin" asp-controller="Home">Administración</a>
                        </li>
                        <li class="breadcrumb-item">
                            <a asp-action="Usuarios">Usuarios</a>
                        </li>
                        <li class="breadcrumb-item active" aria-current="page">
                            Agregar
                        </li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-body">
                    <form asp-action="AgregarUsuario" asp-controller="Cuentas" method="post" autocomplete="off">
                        <div class="row">
                            <div class="col-md-12">
                                <div asp-validation-summary="ModelOnly"></div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-sm-12 col-md-4">
                                <div class="form-group">
                                    <label asp-for="Nombre"></label>
                                    <input asp-for="Nombre" class="form-control form-control-sm" placeholder="Digite el nombre" />
                                    <span asp-validation-for="Nombre"></span>
                                </div>
                            </div>

                            <div class="col-sm-12 col-md-4">
                                <div class="form-group">
                                    <label asp-for="PrimerApellido"></label>
                                    <input asp-for="PrimerApellido" class="form-control form-control-sm" placeholder="Digite el primer apellido" />
                                    <span asp-validation-for="PrimerApellido"></span>
                                </div>
                            </div>

                            <div class="col-sm-12 col-md-4">
                                <div class="form-group">
                                    <label asp-for="SegundoApellido"></label>
                                    <input asp-for="SegundoApellido" class="form-control form-control-sm" placeholder="Digite el segundo apellido" />
                                    <span asp-validation-for="SegundoApellido"></span>
                                </div>
                            </div>

                            <div class="col-sm-12 col-md-4">
                                <div class="form-group">
                                    <label asp-for="NumeroIdentificacion"></label>
                                    <input asp-for="NumeroIdentificacion" class="form-control form-control-sm" placeholder="Digite el número de identificación" />
                                    <span asp-validation-for="NumeroIdentificacion"></span>
                                </div>
                            </div>

                            <div class="col-sm-12 col-md-4">
                                <div class="form-group">
                                    <label asp-for="CorreoElectronico"></label>
                                    <input asp-for="CorreoElectronico" class="form-control form-control-sm" placeholder="Digite el correo electrónico" />
                                    <span asp-validation-for="CorreoElectronico"></span>
                                </div>
                            </div>

                            <div class="col-sm-12 col-md-4">
                                <div class="form-group">
                                    <label asp-for="Contrasena"></label>
                                    <input asp-for="Contrasena" class="form-control form-control-sm" placeholder="Digite la contraseña" />
                                    <span asp-validation-for="Contrasena"></span>
                                </div>
                            </div>

                            <div class="col-sm-12 col-md-4">
                                <div class="form-group">
                                    <label asp-for="ConfirmarContrasena"></label>
                                    <input asp-for="ConfirmarContrasena" class="form-control form-control-sm" placeholder="Confirmar contraseña" />
                                    <span asp-validation-for="ConfirmarContrasena"></span>
                                </div>
                            </div>

                            <div class="form-group">
                                <div class="col-sm-12 col-md-4">
                                    <div class="form-group">
                                        <label asp-for="Estado"></label>
                                        <br />
                                        <input asp-for="Estado" type="checkbox" />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-sm-12">
                                <span class="font-bold">Roles</span>
                            </div>
                            <div class="col-sm-12 mt-2">
                                <div class="row">
                                    @foreach (var rol in ViewBag.ListaRoles) {
                                        <div class="col-sm-12 col-md-3 d-inline">
                                            <div class="row">
                                                <div class="col-1 d-inline">
                                                    <input type="checkbox" id="R_@rol.Text" name="R_@rol.Text" value="@rol.Text" />
                                                </div>
                                                <div class="clearfix"></div>
                                                <div class="col-10">
                                                    <label for="R_@rol.Text">@rol.Text</label>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="row mt-2">
                            <div class="col-12">
                                <button type="submit" class="btn btn-sm btn-primary">Guardar</button>
                                <a asp-action="Usuarios" class="btn btn-sm btn-secondary">Regresar</a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <partial name="_ValidationScriptsPartial" />
}

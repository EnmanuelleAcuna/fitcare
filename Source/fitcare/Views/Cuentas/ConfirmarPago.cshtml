@model ConfirmarPagoViewModel

@{
	ViewBag.Title = "Confirmar Pago";
}

<div class="container">
	<div class="row">
		<div class="col-5 align-self-center">
			<h6 class="page-title">Confirmar Pago de Membresía</h6>
		</div>
		<div class="col-7 align-self-center">
			<div class="d-flex align-items-center justify-content-end">
				<nav aria-label="breadcrumb">
					<ol class="breadcrumb">
						<li class="breadcrumb-item">
							<a asp-action="Admin" asp-controller="Home">Administración</a>
						</li>
						<li class="breadcrumb-item">
							<a asp-action="PagosMembresia" asp-controller="Cuentas">Pagos de Membresía</a>
						</li>
						<li class="breadcrumb-item active" aria-current="page">Confirmar Pago</li>
					</ol>
				</nav>
			</div>
		</div>
	</div>

	<div class="row">
		<div class="col-12">
			<div class="card shadow-sm">
				<div class="card-body">
					<form asp-action="RegistrarPago" asp-route-id="@Model.IdCliente" method="post">
						@Html.AntiForgeryToken()

						<div class="row">
							<div class="col-md-6">
								<div class="form-group">
									<label>Cliente</label>
									<input type="text" class="form-control form-control-sm" value="@Model.NombreCompleto" readonly />
								</div>
							</div>
							<div class="col-md-6">
								<div class="form-group">
									<label>Plan de Membresía</label>
									<input type="text" class="form-control form-control-sm" value="@Model.NombrePlan (@Model.MesesPlan @(Model.MesesPlan == 1 ? "mes" : "meses"))" readonly />
								</div>
							</div>
						</div>

						<div class="row">
							<div class="col-md-4">
								<div class="form-group">
									<label>Fecha Inscripción</label>
									<input type="text" class="form-control form-control-sm" value="@Model.FechaInscripcion.ToString("dd/MM/yyyy")" readonly />
								</div>
							</div>
							<div class="col-md-4">
								<div class="form-group">
									<label>Fecha Renovación Actual</label>
									<input type="text" class="form-control form-control-sm" value="@Model.FechaRenovacionActual.ToString("dd/MM/yyyy")" readonly />
								</div>
							</div>
							<div class="col-md-4">
								<div class="form-group">
									<label>Nueva Fecha Renovación</label>
									<input type="text" class="form-control form-control-sm bg-success text-white" value="@Model.NuevaFechaRenovacion.ToString("dd/MM/yyyy")" readonly />
								</div>
							</div>
						</div>
					
						<div class="row">
							<div class="col-md-12">
								<div class="alert alert-info">
									<i class="fa fa-info-circle"></i>
									Al confirmar, la membresía se extenderá <strong>@Model.MesesPlan @(Model.MesesPlan == 1 ? "mes" : "meses")</strong>.
								</div>
							</div>
						</div>

						<div class="row">
							<div class="col-12">
								<button type="submit" class="btn btn-sm btn-primary">Confirmar Pago</button>
								<a asp-action="PagosMembresia" class="btn btn-sm btn-secondary">Cancelar</a>
							</div>
						</div>
					</form>
				</div>
			</div>
		</div>
	</div>
</div>

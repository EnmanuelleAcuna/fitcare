@model AgregarClienteViewModel

@{
	ViewBag.Title = "Clientes";
}

<div class="container">
	<div class="row">
		<div class="col-5 align-self-center">
			<h6 class="page-title">Editar cliente</h6>
		</div>
		<div class="col-7 align-self-center">
			<div class="d-flex align-items-center justify-content-end">
				<nav aria-label="breadcrumb">
					<ol class="breadcrumb">
						<li class="breadcrumb-item">
							<a asp-action="Admin" asp-controller="Home">Administración</a>
						</li>
						<li class="breadcrumb-item">
							<a asp-action="Clientes" asp-controller="Cuentas">Clientes</a>
						</li>
						<li class="breadcrumb-item active" aria-current="page">
							Editar cliente
						</li>
					</ol>
				</nav>
			</div>
		</div>
	</div>

	<div class="row">
		<div class="col-12">
			<div class="card shadow-sm">
				<div class="card-body">
					<form asp-action="EditarCliente" asp-controller="Cuentas" method="post" autocomplete="off" enctype="multipart/form-data">
						<input asp-for="IdUsuario" type="hidden" />

						<div class="row">
							<div class="col-md-12">
								<div asp-validation-summary="ModelOnly"></div>
							</div>
						</div>

						<div class="row">
							<div class="col-md-12">
								<p>Editar información de <strong>@Model.Nombre</strong> (@Model.Correo)</p>
							</div>

							<div class="col-sm-12 col-md-4">
								<div class="form-group">
									<label asp-for="IdProvincia"></label>
									<select asp-for="IdProvincia" asp-items="@(new SelectList(ViewBag.Provincias, "Value", "Text"))" class="form-control form-control-sm" id="selectProvincia">
										<option value="">Seleccione una provincia</option>
									</select>
									<span asp-validation-for="IdProvincia"></span>
								</div>
							</div>

							<div class="col-sm-12 col-md-4">
								<div class="form-group">
									<label asp-for="IdCanton"></label>
									<select asp-for="IdCanton" asp-items="@(new SelectList(ViewBag.Cantones, "Value", "Text"))" class="form-control form-control-sm" id="selectCanton">
										<option value="">Seleccione un cantón</option>
									</select>
									<span asp-validation-for="IdCanton"></span>
								</div>
							</div>

							<div class="col-sm-12 col-md-4">
								<div class="form-group">
									<label asp-for="IdDistrito"></label>
									<select asp-for="IdDistrito" asp-items="@(new SelectList(ViewBag.Distritos, "Value", "Text"))" class="form-control form-control-sm" id="selectDistrito">
										<option value="">Seleccione un distrito</option>
									</select>
									<span asp-validation-for="IdDistrito"></span>
								</div>
							</div>

							<div class="col-sm-12 col-md-4">
								<div class="form-group">
									<label asp-for="FechaInscripcion"></label>
									<br />
									<input asp-for="FechaInscripcion" class="form-control form-control-sm" />
									<span asp-validation-for="FechaInscripcion" class="text-danger"></span>
								</div>
							</div>

							<div class="col-sm-12 col-md-4">
								<div class="form-group">
									<label asp-for="FechaRenovacion"></label>
									<br />
									<input asp-for="FechaRenovacion" class="form-control form-control-sm" />
									<span asp-validation-for="FechaRenovacion" class="text-danger"></span>
								</div>
							</div>

							<div class="col-12">
								<button type="submit" class="btn btn-sm btn-primary">Guardar</button>
								<a asp-action="Clientes" class="btn btn-sm btn-secondary">Regresar</a>
							</div>
						</div>
					</form>
				</div>
			</div>
		</div>
	</div>
</div>

@section Scripts{
	<partial name="_ValidationScriptsPartial" />

	<script type="text/javascript">
		$(document).ready(function () {
			initCascadingDropdowns({
				provinciaSelector: '#selectProvincia',
				cantonSelector: '#selectCanton',
				distritoSelector: '#selectDistrito',
				cantonesUrl: '@Url.Action("ObtenerCantonesPorProvincia", "Cuentas")',
				distritosUrl: '@Url.Action("ObtenerDistritosPorCanton", "Cuentas")'
			});
		});
	</script>
}

@model EditarRolViewModel

@{
	ViewBag.Title = "Roles";
}

<div class="container">
	<div class="row">
		<div class="col-5 align-self-center">
			<h6 class="page-title">Modificar rol</h6>
		</div>
		<div class="col-7 align-self-center">
			<div class="d-flex align-items-center justify-content-end">
				<nav aria-label="breadcrumb">
					<ol class="breadcrumb">
						<li class="breadcrumb-item">
							<a asp-action="Admin" asp-controller="Home">Administración</a>
						</li>
						<li class="breadcrumb-item">
							<a asp-action="Roles">Roles</a>
						</li>
						<li class="breadcrumb-item active" aria-current="page">
							Modificar
						</li>
					</ol>
				</nav>
			</div>
		</div>
	</div>

	<div class="row">
		<div class="col-12">
			<div class="card shadow-sm">
				<div class="card-body">
					<form asp-action="EditarRol" asp-controller="Cuentas" method="post" autocomplete="off">
						<input asp-for="IdRol" type="hidden" />

						<div class="row">
							<div class="col-md-12">
								<div asp-validation-summary="ModelOnly"></div>
							</div>
						</div>

						<div class="row">
							<div class="col-sm-12 col-md-4">
								<div class="form-group">
									<label asp-for="Nombre"></label>
									<input asp-for="Nombre" class="form-control form-control-sm" placeholder="Digite el nombre" />
									<span asp-validation-for="Nombre"></span>
								</div>
							</div>

							<div class="col-sm-12 col-md-4">
								<div class="form-group">
									<label asp-for="Estado"></label>
									<br />
									<input asp-for="Estado" type="checkbox" />
								</div>
							</div>

							<div class="col-12">
								<div class="form-group">
									<label asp-for="Descripcion"></label>
									<textarea asp-for="Descripcion" class="form-control form-control-sm" rows="4" placeholder="Digite la descripcion"></textarea>
									<span asp-validation-for="Descripcion"></span>
								</div>
							</div>

							<div class="col-12">
								<button type="submit" class="btn btn-sm btn-primary">Guardar</button>
								<a asp-action="Roles" class="btn btn-sm btn-secondary">Regresar</a>
							</div>
						</div>
					</form>
				</div>
			</div>
		</div>
	</div>
</div>

@section Scripts{
	<partial name="_ValidationScriptsPartial" />
}

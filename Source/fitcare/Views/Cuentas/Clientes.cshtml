@model IEnumerable<ClienteListViewModel>

@{
	ViewBag.Title = "Clientes";
}

<div class="container">
	<div class="row">
		<div class="col-5 align-self-center">
			<h6 class="page-title">Clientes</h6>
		</div>
		<div class="col-7 align-self-center">
			<div class="d-flex align-items-center justify-content-end">
				<nav aria-label="breadcrumb">
					<ol class="breadcrumb">
						<li class="breadcrumb-item">
							<a href="@Url.Action("Admin", "Home")">Administración</a>
						</li>
						<li class="breadcrumb-item active" aria-current="page">
							Clientes
						</li>
					</ol>
				</nav>
			</div>
		</div>
	</div>

	<div class="row">
		<div class="col-12">
			<div class="card shadow-sm">
				<div class="card-header d-flex justify-content-between align-items-center">
					<span>Lista de clientes</span>
					<a href="@Url.Action("ExportarClientes", "Cuentas")" class="btn btn-success btn-sm">
						<i class="fas fa-file-excel"></i> Exportar a Excel
					</a>
				</div>
				<div class="card-body">
					<div class="table-responsive">
						<table class="table table-hover table-sm text-nowrap">
							<thead>
								<tr>
									<th>Identificación</th>
									<th>Nombre completo</th>
									<th>Correo electrónico</th>
									<th>Estado</th>
									<th>Membresía</th>
									<th></th>
								</tr>
							</thead>
							<tbody>
								@foreach (var cliente in Model)
								{
									<tr>
										<td>@cliente.NumeroIdentificacion</td>
										<td>@cliente.NombreCompleto</td>
										<td>@cliente.Correo</td>
										<td>
											@if (cliente.Estado == "Activo")
											{
												<span class="badge bg-success text-white">@cliente.Estado</span>
											}
											else
											{
												<span class="badge bg-secondary">@cliente.Estado</span>
											}
										</td>
										<td>@cliente.Membresia</td>
										<td>
											<a href="@Url.Action("EditarCliente", "Cuentas", new { id = cliente.IdUsuario })" class="btn btn-outline-primary btn-sm">
												Modificar
											</a>
											<button type="button" class="btn btn-outline-danger btn-sm"
												data-toggle="modal"
												data-target="#desafiliarModal"
												data-id="@cliente.IdUsuario"
												data-nombre="@cliente.NombreCompleto">
												Desafiliar
											</button>
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

<!-- Modal de confirmación -->
<div class="modal fade" id="desafiliarModal" tabindex="-1" role="dialog" aria-labelledby="desafiliarModalLabel" aria-hidden="true">
	<div class="modal-dialog" role="document">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title" id="desafiliarModalLabel">Confirmar desafiliación</h5>
				<button type="button" class="close" data-dismiss="modal" aria-label="Cerrar">
					<span aria-hidden="true">&times;</span>
				</button>
			</div>
			<div class="modal-body">
				<p>¿Está seguro que desea desafiliar a <strong id="nombreCliente"></strong> como cliente?</p>
				<p class="text-muted small">El usuario no será eliminado, solo se removerá su rol de cliente.</p>
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-secondary" data-dismiss="modal">Cancelar</button>
				<button type="button" class="btn btn-danger" id="confirmarDesafiliacion">Desafiliar</button>
			</div>
		</div>
	</div>
</div>

@section Scripts {
	<script>
		$(document).ready(function () {
			initModalConfirmation({
				modalSelector: '#desafiliarModal',
				nameDisplaySelector: '#nombreCliente',
				confirmButtonSelector: '#confirmarDesafiliacion',
				actionUrl: '@Url.Action("DesafiliarCliente", "Cuentas")',
				errorMessage: 'Error al desafiliar el cliente'
			});
		});
	</script>
}

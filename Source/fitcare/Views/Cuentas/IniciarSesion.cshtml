@model IniciarSesionViewModel

@{
	ViewData["Title"] = "Iniciar sesión";
}

<div class="container">
	<div class="row">
		<div class="col-sm-12 col-md-4 offset-md-4">
			<h4 class="text-center mt-2 mb-4 font-light">Iniciar sesión</h4>

			<div class="card shadow-sm">
				<div class="card-body">
					<form asp-action="IniciarSesion" asp-controller="Cuentas" asp-route-returnUrl="@ViewBag.ReturnUrl" method="post" autocomplete="off">
						<div class="form-group">
							<label asp-for="Correo" class="font-bold"></label>
							<input asp-for="Correo" class="form-control form-control-sm" />
							<span asp-validation-for="Correo" class="text-danger"></span>
						</div>

						<div class="form-group">
							<label asp-for="Contrasena" class="font-bold"></label>
							<input asp-for="Contrasena" class="form-control form-control-sm" />
							<span asp-validation-for="Contrasena" class="text-danger"></span>
						</div>

						<div class="center red-text font-bold">
							<div asp-validation-summary="ModelOnly" class="data-error"></div>
						</div>

						<div class="w-100 text-center">
							<button type="submit" class="btn btn-sm btn-primary btn-block font-bold mb-2">
								Iniciar sesión
							</button>

							<small>
								<a asp-action="SolicitarContrasena" asp-controller="Cuentas" class="text-secondary" title="¿Olvidó su contraseña?">
									¿Olvidó su contraseña?
								</a>
							</small>
						</div>
					</form>
				</div>
			</div>
		</div>
	</div>
</div>

@section Scripts{
	<partial name="_ValidationScriptsPartial" />
}

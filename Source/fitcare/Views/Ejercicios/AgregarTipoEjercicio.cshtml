@model AgregarTipoEjercicioViewModel

@{
    ViewBag.Title = "Tipos de ejercicio";
}

<div class="container">
    <div class="row">
        <div class="col-5 align-self-center">
            <h6 class="page-title">Agregar tipo de ejercicio</h6>
        </div>
        <div class="col-7 align-self-center">
            <div class="d-flex align-items-center justify-content-end">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item">
                            <a asp-action="Admin" asp-controller="Home">Administración</a>
                        </li>
                        <li class="breadcrumb-item">
                            <a asp-action="TiposEjercicio">Tipos de ejercicio</a>
                        </li>
                        <li class="breadcrumb-item active" aria-current="page">
                            Agregar
                        </li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-body">
                    <form asp-action="AgregarTipoEjercicio" asp-controller="Ejercicios" method="post" autocomplete="off">
                        <div class="row">
                            <div class="col-md-12">
                                <div asp-validation-summary="ModelOnly"></div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-sm-12 col-md-4">
                                <div class="form-group">
                                    <label asp-for="Codigo"></label>
                                    <input asp-for="Codigo" class="form-control form-control-sm" placeholder="Digite el codigo del tipo de ejercicio" />
                                    <span asp-validation-for="Codigo" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-sm-12 col-md-4">
                                <div class="form-group">
                                    <label asp-for="Nombre"></label>
                                    <input asp-for="Nombre" class="form-control form-control-sm" placeholder="Digite el nombre del tipo de ejercicio" />
                                    <span asp-validation-for="Nombre" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-sm-12 col-md-4">
                                <div class="form-group">
                                    <label asp-for="Estado"></label>
                                    <br />
                                    <input asp-for="Estado" type="checkbox" />
                                </div>
                            </div>

                            <div class="col-12">
                                <button type="submit" class="btn btn-sm btn-primary">Guardar</button>
                                <a asp-action="TiposEjercicio" class="btn btn-sm btn-secondary">Regresar</a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

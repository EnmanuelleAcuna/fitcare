@model EditarEjercicioViewModel

@{
    ViewBag.Title = "Ejercicios";
}

<div class="container">
    <div class="row">
        <div class="col-5 align-self-center">
            <h6 class="page-title">Modificar ejercicio</h6>
        </div>
        <div class="col-7 align-self-center">
            <div class="d-flex align-items-center justify-content-end">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item">
                            <a href="@Url.Action("Admin", "Home")">Administración</a>
                        </li>
                        <li class="breadcrumb-item">
                            <a href="@Url.Action("ListarEjercicios")">Ejercicios</a>
                        </li>
                        <li class="breadcrumb-item active" aria-current="page">
                            Modificar
                        </li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-body">
                    @using (Html.BeginForm("EditarEjercicio", "Ejercicios", FormMethod.Post, new { autocomplete = "off" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(model => model.Id)

                        <div class="row">
                            <div class="col-md-12">
                                @Html.ValidationSummary(true, "")
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-sm-12 col-md-3">
                                <div class="form-group">
                                    @Html.LabelFor(model => model.Codigo)
                                    @Html.TextBoxFor(model => model.Codigo, "", new { @class = "form-control form-control-sm", placeholder = "Digite el código del ejercicio" })
                                    @Html.ValidationMessageFor(model => model.Codigo, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="col-sm-12 col-md-4">
                                <div class="form-group">
                                    @Html.LabelFor(model => model.Nombre)
                                    @Html.TextBoxFor(model => model.Nombre, "", new { @class = "form-control form-control-sm", placeholder = "Digite el nombre del ejercicio" })
                                    @Html.ValidationMessageFor(model => model.Nombre, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="col-sm-12 col-md-3">
                                <div class="form-group">
                                    @Html.LabelFor(model => model.IdTipoEjercicio)
                                    @Html.DropDownListFor(model => model.IdTipoEjercicio, new List<SelectListItem>(ViewBag.ListaTiposEjercicio), "Seleccione un tipo de ejercicio", new { @class = "form-control form-control-sm" })
                                    @Html.ValidationMessageFor(model => model.IdTipoEjercicio)
                                </div>
                            </div>

                            <div class="col-sm-12 col-md-2">
                                <div class="form-group">
                                    @Html.LabelFor(model => model.Activo)
                                    <br />
                                    @Html.EditorFor(model => model.Activo, "", new { @class = "form-control" })
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-sm-12 col-md-6">
                                <div class="form-group">
                                    @Html.LabelFor(model => model.IdsGruposMusculares)
                                    <select id="IdsGruposMusculares" name="IdsGruposMusculares" class="form-control form-control-sm" multiple="multiple">
                                        @foreach (var item in (List<SelectListItem>)ViewBag.ListaGruposMusculares)
                                        {
                                            if (Model.IdsGruposMusculares.Contains(item.Value))
                                            {
                                                <option value="@item.Value" selected>@item.Text</option>
                                            }
                                            else
                                            {
                                                <option value="@item.Value">@item.Text</option>
                                            }
                                        }
                                    </select>
                                    <small class="form-text text-muted">Seleccione uno o más grupos musculares</small>
                                </div>
                            </div>

                            <div class="col-sm-12 col-md-6">
                                <div class="form-group">
                                    @Html.LabelFor(model => model.IdsMaquinas)
                                    <select id="IdsMaquinas" name="IdsMaquinas" class="form-control form-control-sm" multiple="multiple">
                                        @foreach (var item in (List<SelectListItem>)ViewBag.ListaMaquinas)
                                        {
                                            if (Model.IdsMaquinas.Contains(item.Value))
                                            {
                                                <option value="@item.Value" selected>@item.Text</option>
                                            }
                                            else
                                            {
                                                <option value="@item.Value">@item.Text</option>
                                            }
                                        }
                                    </select>
                                    <small class="form-text text-muted">Seleccione una o más máquinas (opcional)</small>
                                </div>
                            </div>
                        </div>

                        <div class="row mt-2">
                            <div class="col-12">
                                <input value="Guardar" class="btn btn-sm btn-primary" type="submit" />
                                @Html.ActionLink("Regresar", "ListarEjercicios", null, null, new { @class = "btn btn-sm btn-secondary" })
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <!-- Select2 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />

    <!-- Select2 JS -->
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script type="text/javascript">
        $(document).ready(function() {
            // Inicializar Select2 para Grupos Musculares
            $('#IdsGruposMusculares').select2({
                placeholder: 'Seleccione grupos musculares',
                allowClear: true,
                width: '100%',
                language: {
                    noResults: function() {
                        return "No se encontraron resultados";
                    },
                    searching: function() {
                        return "Buscando...";
                    }
                }
            });

            // Inicializar Select2 para Máquinas
            $('#IdsMaquinas').select2({
                placeholder: 'Seleccione máquinas (opcional)',
                allowClear: true,
                width: '100%',
                language: {
                    noResults: function() {
                        return "No se encontraron resultados";
                    },
                    searching: function() {
                        return "Buscando...";
                    }
                }
            });
        });
    </script>
}

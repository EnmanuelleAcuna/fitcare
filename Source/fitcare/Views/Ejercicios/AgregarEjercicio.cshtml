@model AgregarEjercicioViewModel

@{
    ViewBag.Title = "Ejercicios";
}

<div class="container">
    <div class="row">
        <div class="col-5 align-self-center">
            <h6 class="page-title">Agregar nuevo ejercicio</h6>
        </div>
        <div class="col-7 align-self-center">
            <div class="d-flex align-items-center justify-content-end">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item">
                            <a asp-action="Admin" asp-controller="Home">Administración</a>
                        </li>
                        <li class="breadcrumb-item">
                            <a asp-action="Ejercicios">Ejercicios</a>
                        </li>
                        <li class="breadcrumb-item active" aria-current="page">
                            Agregar
                        </li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-body">
                    <form asp-action="AgregarEjercicio" asp-controller="Ejercicios" method="post" autocomplete="off">
                        <div class="row">
                            <div class="col-md-12">
                                <div asp-validation-summary="ModelOnly"></div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-sm-12 col-md-3">
                                <div class="form-group">
                                    <label asp-for="Codigo"></label>
                                    <input asp-for="Codigo" class="form-control form-control-sm" placeholder="Digite el código del ejercicio" />
                                    <span asp-validation-for="Codigo" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-sm-12 col-md-4">
                                <div class="form-group">
                                    <label asp-for="Nombre"></label>
                                    <input asp-for="Nombre" class="form-control form-control-sm" placeholder="Digite el nombre del ejercicio" />
                                    <span asp-validation-for="Nombre" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-sm-12 col-md-3">
                                <div class="form-group">
                                    <label asp-for="IdTipoEjercicio"></label>
                                    <select asp-for="IdTipoEjercicio" asp-items="@(new SelectList(ViewBag.ListaTiposEjercicio, "Value", "Text"))" class="form-control form-control-sm">
                                        <option value="">Seleccione un tipo de ejercicio</option>
                                    </select>
                                    <span asp-validation-for="IdTipoEjercicio"></span>
                                </div>
                            </div>

                            <div class="col-sm-12 col-md-2">
                                <div class="form-group">
                                    <label asp-for="Activo"></label>
                                    <br />
                                    <input asp-for="Activo" type="checkbox" />
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-sm-12 col-md-6">
                                <div class="form-group">
                                    <label asp-for="IdsGruposMusculares"></label>
                                    <select id="IdsGruposMusculares" name="IdsGruposMusculares" class="form-control form-control-sm" multiple="multiple">
                                        @foreach (var item in (List<SelectListItem>)ViewBag.ListaGruposMusculares)
                                        {
                                            <option value="@item.Value">@item.Text</option>
                                        }
                                    </select>
                                    <small class="form-text text-muted">Seleccione uno o más grupos musculares</small>
                                </div>
                            </div>

                            <div class="col-sm-12 col-md-6">
                                <div class="form-group">
                                    <label asp-for="IdsMaquinas"></label>
                                    <select id="IdsMaquinas" name="IdsMaquinas" class="form-control form-control-sm" multiple="multiple">
                                        @foreach (var item in (List<SelectListItem>)ViewBag.ListaMaquinas)
                                        {
                                            <option value="@item.Value">@item.Text</option>
                                        }
                                    </select>
                                    <small class="form-text text-muted">Seleccione una o más máquinas (opcional)</small>
                                </div>
                            </div>
                        </div>

                        <div class="row mt-2">
                            <div class="col-12">
                                <button type="submit" class="btn btn-sm btn-primary">Guardar</button>
                                <a asp-action="Ejercicios" class="btn btn-sm btn-secondary">Regresar</a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <!-- Select2 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />

    <!-- Select2 JS -->
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script type="text/javascript">
        $(document).ready(function() {
            $('#IdsGruposMusculares').select2({
                placeholder: 'Seleccione grupos musculares',
                allowClear: true,
                width: '100%',
                language: {
                    noResults: function() { return "No se encontraron resultados"; },
                    searching: function() { return "Buscando..."; }
                }
            });

            $('#IdsMaquinas').select2({
                placeholder: 'Seleccione máquinas (opcional)',
                allowClear: true,
                width: '100%',
                language: {
                    noResults: function() { return "No se encontraron resultados"; },
                    searching: function() { return "Buscando..."; }
                }
            });
        });
    </script>
}

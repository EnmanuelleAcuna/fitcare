@{
	ViewData["Title"] = "Acerca de";
}

<div class="container">
	<div class="jumbotron p-4 bg-white shadow-sm">
		<div class="row">
			<div class="col-sm-12 col-md-5">
				<div id="Carousel" class="carousel slide" data-ride="carousel" data-interval="5000">
					<!-- Contenedor para contenido deslizable  -->
					<div class="carousel-inner">
						<div class="carousel-item active">
							<img src="~/images/Index/Banner1.jpg" alt="Gimnasio 1" class="img-fluid rounded"/>
						</div>
						<div class="carousel-item">
							<img src="~/images/Index/Banner2.jpg" alt="Gimnasio 2" class="img-fluid rounded"/>
						</div>
						<div class="carousel-item">
							<img src="~/images/Index/Banner3.jpg" alt="Gimnasio 3" class="img-fluid rounded"/>
						</div>
					</div>
				</div>
			</div>

			<div class="col-sm-12 col-md-7 text-center">
				<img class="img-fluid max-height-96px mt-4 mb-2" src="~/images/fitcare_logo.png" alt="Logo fitcare">
				<p class="lead mt-4">
                  Supera tus límites, alcanza tu mejor versión</b>
				</p>
			</div>
		</div>
	</div>

	<div class="row pb-4">
		<div class="col-sm-12">
			<div class="card-deck">
				<div class="card shadow-sm">
					<div class="card-title">
						<h4 class="pt-4	font-bold text-center">
							Gimnasio fit<strong>care</strong>
						</h4>
					</div>
					<div class="card-body">
						<p class="card-text text-justify">
                            Más que un gimnasio somos un centro de energía, salud y movimiento.
                            Entrena con nosotros en programas de fuerza, pilates, zumba, crossfit, spinning y más, con apoyo profesional en nutrición y fisioterapia.
                            Activa tu cuerpo, transforma tu vida..
						</p>
					</div>
				</div>
			</div>
		</div>
	</div>

	<div class="row">
		<div class="col-sm-12">
			<div class="card-deck">
				<div class="card shadow-sm">
					<img class="card-img-top max-height-96px" src="~/images/gym-tool.svg" alt="Rutinas">
					<div class="card-body">
						<h5 class="card-title text-center">
							Planes de entrenamiento
							<br/>(Rutinas)
						</h5>
						<p class="card-text text-justify">
                            Planes de entrenamiento personalizados — individuales o grupales — diseñados de acuerdo a tus metas y necesidades específicas.
                            Desde la recuperación de lesiones hasta el cumplimiento de objetivos personales, te acompañamos en cada etapa del proceso.
						</p>
						<p class="card-text text-justify">
							Esta plataforma le permite gestionar y completar sus rutinas desde cualquier lugar y
							dispositivo.
						</p>
						<p class="card-text text-justify">
							Conozca más acerca de nuestros planes de entrenamiento disponibles en fit<strong>care</strong>.
						</p>
					</div>
				</div>

				<div class="card shadow-sm">
					<img class="card-img-top max-height-96px" src="~/images/fitness-forever.svg" alt="Entrenamiento">
					<div class="card-body">
						<h5 class="card-title text-center">
							Planes alimenticios
							<br/>
							(Nutrición)
						</h5>
						<p class="card-text text-justify">
							Planes de alimentación y asesorías personalizados para acompañar los planes de entrenamiento
							o
							mejorar el balance alimenticio y la salud.
						</p>
						<p class="card-text text-justify">
							Esta plataforma le permite mejorar el cumplimiento de sus metas alimenticias para mejorar su
							salud y estilo de vida desde cualquier lugar y dispositivo.
						</p>
						<p class="card-text text-justify">
							Conozca más acerca de los planes alimenticios de fit<strong>care</strong>.
						</p>
					</div>
				</div>

				<div class="card shadow-sm">
					<img class="card-img-top max-height-96px" src="~/images/wellness.svg" alt="Clientes">
					<div class="card-body">
						<h5 class="card-title text-center">
							Capital humano
							<br/>
							(y herramientas de trabajo)
						</h5>
						<p class="card-text text-justify">
							Instructores profesionales y con gran trayectoria y experiencia, respaldados por
							instalaciones,
							equipos y herramientas de calidad para cumplir mas eficientemente los objetivos.
						</p>
						<p class="card-text text-justify">
							Esta plataforma le permite llevar un ágil y completo seguimiento con su instructor desde
							cualquier lugar y dispositivo.
						</p>
						<p class="card-text text-justify">
							Conozca más acerca de los instructores de fit<strong>care</strong>.
						</p>
					</div>
				</div>
			</div>
		</div>
	</div>

	<div class="jumbotron mt-4 p-4 bg-white shadow-sm">
		<div class="row">
			<div class="col-sm-12 col-md-5">
				<iframe
					src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3167.5906925025197!2d25.329344025122776!3d37.44677298121658!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x14a2bf2a8c16b079%3A0x2f5d71c266f21430!2zTnVzci1ldCDOnM-NzrrOv869zr_Pgg!5e0!3m2!1ses-419!2scr!4v1598164540444!5m2!1ses-419!2scr"
					frameborder="0" style="border:0; width: 100%; height: 100%;" allowfullscreen="" aria-hidden="false"
					tabindex="0">
				</iframe>
			</div>

			<div class="col-sm-12 col-md-7 text-center">
				<p class="lead">
					<b>Dirección: </b>En algún lugar de Costa Rica, donde se entrenan los sueños.
				</p>

				<p class="lead">
					<b>Teléfono: </b><a href="tel:+50688880000"><span class="glyphicon glyphicon-earphone"></span>&nbsp;88880000</a>
				</p>

				<p class="lead">
					<b>Correo electrónico: </b>
					<a href="mailto:gimnasiosperformancecenter@outlook.com">
					<span
						class="glyphicon glyphicon-earphone">
					</span>gimnasiosperformancecenter@outlook.com
					</a>
				</p>
			</div>
		</div>
	</div>

	<div class="jumbotron mt-4 p-4 bg-white shadow-sm text-center">
		<img class="img-fluid max-height-96px" src="~/images/hacking.svg" alt="Rutinas">

		<h4 class="font-light text-primary">Declaración de privacidad</h4>
		<p class="lead">
			Al navegar dentro de este sitio usted está aceptando todos los términos y condiciones de uso de fit<strong>care</strong>.
		</p>

		<p class="lead">
			El uso de cookies es requerido para el buen funcionamiento del sitio web.
		</p>
	</div>
</div>

@model EditarTipoMedidaViewModel

<!-- Modal Editar -->
<div class="modal fade" id="ModalEditar" tabindex="-1" role="dialog" aria-labelledby="ModalEditarTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title" id="ModalEditarTitle">
                    <i class="fa fa-fw fa-edit"></i>
                    Modificar tipo de medida
                </h6>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true"><i class="fa fa-fw fa-window-close"></i></span>
                </button>
            </div>
            @using (Html.BeginForm("EditarAjax", "TiposMedida", FormMethod.Post, new { id = "formEditar" }))
            {
                @Html.AntiForgeryToken()

                <div class="modal-body">
                    @Html.ValidationSummary(false, "", new { @class = "alert alert-danger" })

                    @Html.HiddenFor(m => m.Id, new { id = "IdEditar" })

                    <div class="form-group">
                        @Html.LabelFor(m => m.Codigo, new { @for = "CodigoEditar" })
                        @Html.TextBoxFor(m => m.Codigo, new { @class = "form-control form-control-sm", id = "CodigoEditar" })
                        @Html.ValidationMessageFor(m => m.Codigo, "", new { @class = "text-danger" })
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(m => m.Nombre, new { @for = "NombreEditar" })
                        @Html.TextBoxFor(m => m.Nombre, new { @class = "form-control form-control-sm", id = "NombreEditar" })
                        @Html.ValidationMessageFor(m => m.Nombre, "", new { @class = "text-danger" })
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(m => m.Estado)
                        <br/>
                        @Html.CheckBoxFor(m => m.Estado, new { id = "EstadoEditar" })
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-light" data-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-sm btn-primary" id="btnGuardarEditar">Guardar</button>
                </div>
            }
        </div>
    </div>
</div>

@model EditarTipoMedidaViewModel

<!-- Modal Editar -->
<div class="modal fade" id="ModalEditar" tabindex="-1" role="dialog" aria-labelledby="ModalEditarTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title" id="ModalEditarTitle">
                    <i class="fa fa-fw fa-edit"></i>
                    Modificar tipo de medida
                </h6>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true"><i class="fa fa-fw fa-window-close"></i></span>
                </button>
            </div>
            <form asp-action="EditarAjax" asp-controller="TiposMedida" method="post" id="formEditar">
                <div class="modal-body">
                    <div asp-validation-summary="All" class="alert alert-danger"></div>

                    <input asp-for="Id" type="hidden" id="IdEditar" />

                    <div class="form-group">
                        <label asp-for="Codigo" for="CodigoEditar"></label>
                        <input asp-for="Codigo" class="form-control form-control-sm" id="CodigoEditar" />
                        <span asp-validation-for="Codigo" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Nombre" for="NombreEditar"></label>
                        <input asp-for="Nombre" class="form-control form-control-sm" id="NombreEditar" />
                        <span asp-validation-for="Nombre" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Estado"></label>
                        <br/>
                        <input asp-for="Estado" type="checkbox" id="EstadoEditar" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-light" data-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-sm btn-primary" id="btnGuardarEditar">Guardar</button>
                </div>
            </form>
        </div>
    </div>
</div>

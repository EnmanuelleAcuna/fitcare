@model AgregarTipoMedidaViewModel

<!-- Modal Agregar -->
<div class="modal fade" id="ModalAgregar" tabindex="-1" role="dialog" aria-labelledby="ModalAgregarTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title" id="ModalAgregarTitle">
                    <i class="fa fa-fw fa-plus-circle"></i>
                    Agregar nuevo tipo de medida
                </h6>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true"><i class="fa fa-fw fa-window-close"></i></span>
                </button>
            </div>
            <form asp-action="AgregarAjax" asp-controller="TiposMedida" method="post" id="formAgregar">
                <div class="modal-body">
                    <div asp-validation-summary="All" class="alert alert-danger"></div>

                    <div class="form-group">
                        <label asp-for="Codigo" for="CodigoAgregar"></label>
                        <input asp-for="Codigo" class="form-control form-control-sm" id="CodigoAgregar" readonly />
                        <span asp-validation-for="Codigo" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Nombre" for="NombreAgregar"></label>
                        <input asp-for="Nombre" class="form-control form-control-sm" placeholder="Digite el nombre del nuevo tipo de medida" id="NombreAgregar" />
                        <span asp-validation-for="Nombre" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Estado"></label>
                        <br/>
                        <input asp-for="Estado" type="checkbox" id="EstadoAgregar" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-light" data-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-sm btn-primary" id="btnGuardarAgregar">Guardar</button>
                </div>
            </form>
        </div>
    </div>
</div>

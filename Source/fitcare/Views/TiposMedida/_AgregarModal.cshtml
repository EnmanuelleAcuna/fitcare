@model AgregarTipoMedidaViewModel

<!-- Modal Agregar -->
<div class="modal fade" id="ModalAgregar" tabindex="-1" role="dialog" aria-labelledby="ModalAgregarTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title" id="ModalAgregarTitle">
                    <i class="fa fa-fw fa-plus-circle"></i>
                    Agregar nuevo tipo de medida
                </h6>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true"><i class="fa fa-fw fa-window-close"></i></span>
                </button>
            </div>
            @using (Html.BeginForm("AgregarAjax", "TiposMedida", FormMethod.Post, new { id = "formAgregar" }))
            {
                @Html.AntiForgeryToken()

                <div class="modal-body">
                    @Html.ValidationSummary(false, "", new { @class = "alert alert-danger" })

                    <div class="form-group">
                        @Html.LabelFor(m => m.Codigo, new { @for = "CodigoAgregar" })
                        @Html.TextBoxFor(m => m.Codigo, new { @class = "form-control form-control-sm", placeholder = "Digite el código del nuevo tipo de medida", id = "CodigoAgregar" })
                        @Html.ValidationMessageFor(m => m.Codigo, "", new { @class = "text-danger" })
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(m => m.Nombre, new { @for = "NombreAgregar" })
                        @Html.TextBoxFor(m => m.Nombre, new { @class = "form-control form-control-sm", placeholder = "Digite el nombre del nuevo tipo de medida", id = "NombreAgregar" })
                        @Html.ValidationMessageFor(m => m.Nombre, "", new { @class = "text-danger" })
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(m => m.Estado)
                        <br/>
                        @Html.CheckBoxFor(m => m.Estado, new { id = "EstadoAgregar" })
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-light" data-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-sm btn-primary" id="btnGuardarAgregar">Guardar</button>
                </div>
            }
        </div>
    </div>
</div>

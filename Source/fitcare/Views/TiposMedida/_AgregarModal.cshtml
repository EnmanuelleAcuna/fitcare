<!-- Modal Agregar -->
<div class="modal fade" id="ModalAgregar" tabindex="-1" role="dialog" aria-labelledby="ModalAgregarTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="ModalAgregarTitle">
                    <i class="fa fa-fw fa-plus-circle"></i>
                    Agregar nuevo tipo de medida
                </h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <form id="formAgregar">
                <div class="modal-body">
                    <div class="alert alert-danger d-none" id="errorAgregar" role="alert"></div>

                    <div class="form-group">
                        <label for="CodigoAgregar">Código</label>
                        <input type="text" class="form-control form-control-sm" id="CodigoAgregar" name="Codigo" placeholder="Digite el código del nuevo tipo de medida" required />
                        <small class="text-danger d-none" id="errorCodigo"></small>
                    </div>

                    <div class="form-group">
                        <label for="NombreAgregar">Nombre</label>
                        <input type="text" class="form-control form-control-sm" id="NombreAgregar" name="Nombre" placeholder="Digite el nombre del nuevo tipo de medida" required />
                        <small class="text-danger d-none" id="errorNombre"></small>
                    </div>

                    <div class="form-group">
                        <label for="EstadoAgregar">Estado</label>
                        <div>
                            <input type="checkbox" id="EstadoAgregar" name="Estado" value="true" checked />
                            <label for="EstadoAgregar" class="ml-1">Activo</label>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-secondary" data-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-sm btn-primary" id="btnGuardarAgregar">Guardar</button>
                </div>
            </form>
        </div>
    </div>
</div>

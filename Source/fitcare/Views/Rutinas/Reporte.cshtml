@model IEnumerable<ReporteRutinaResumidoViewModel>

@{
	ViewBag.Title = "Reporte de Rutinas";
}

<div class="container">
	<div class="row">
		<div class="col-5 align-self-center">
			<h6 class="page-title">Reporte de Rutinas</h6>
		</div>
		<div class="col-7 align-self-center">
			<div class="d-flex align-items-center justify-content-end">
				<nav aria-label="breadcrumb">
					<ol class="breadcrumb">
						<li class="breadcrumb-item">
							<a href='@Url.Action("Administracion", "Home")'>Administración</a>
						</li>
						<li class="breadcrumb-item active" aria-current="page">
							Rutinas
						</li>
					</ol>
				</nav>
			</div>
		</div>
	</div>
</div>

<div class="container-fluid">
	<div class="row">
		<div class="col-12">
			<div class="card shadow-sm">
				<div class="card-body">
					@using (Html.BeginForm("Reporte", "Rutinas", FormMethod.Post, new { autocomplete = "off" }))
					{
						<div class="row mb-4">
							<div class="col-sm-12 col-md-4">
								<div class="form-group">
									<label for="idInstructor">Filtrar por Instructor</label>
									@Html.DropDownList("idInstructor", new List<SelectListItem>(ViewBag.ListaInstructores), "Todos los instructores", new { @class = "form-control form-control-sm", id = "idInstructor" })
								</div>
							</div>

							<div class="col-sm-12 col-md-4">
								<div class="form-group">
									<label for="idCliente">Filtrar por Cliente</label>
									@Html.DropDownList("idCliente", new List<SelectListItem>(ViewBag.ListaClientes), "Todos los clientes", new { @class = "form-control form-control-sm", id = "idCliente" })
								</div>
							</div>

							<div class="col-sm-12 col-md-4">
								<label>&nbsp;</label>
								<button type="submit" class="btn btn-sm btn-info d-block w-100">
									<i class="fa fa-filter">&nbsp;</i>Filtrar
								</button>
							</div>
						</div>
					}

					<div class="table table-responsive">
						<table id="example" class="display" style="width:100%">
							<caption>
								<small>
								Reporte generado por el usuario: <span class="font-weight-bold">@User.Identity.Name</span>, el:
								<span
									class="font-weight-bold">
									@DateTime.Now
								</span>
								</small>
							</caption>
							<thead>
							<tr>
								<th>@Html.DisplayNameFor(m => m.FirstOrDefault().NombreInstructor)</th>
								<th>@Html.DisplayNameFor(m => m.FirstOrDefault().NombreCliente)</th>
								<th>@Html.DisplayNameFor(m => m.FirstOrDefault().FechaRegistro)</th>
								<th>@Html.DisplayNameFor(m => m.FirstOrDefault().FechaInicio)</th>
								<th>@Html.DisplayNameFor(m => m.FirstOrDefault().FechaFin)</th>
								<th>@Html.DisplayNameFor(m => m.FirstOrDefault().Objetivo)</th>
								<th>@Html.DisplayNameFor(m => m.FirstOrDefault().DiasRutina)</th>
								<th>@Html.DisplayNameFor(m => m.FirstOrDefault().CantidadEjerciciosRegistrados)</th>
							</tr>
							</thead>
							<tbody>
							@foreach (var rutina in Model)
							{
								<tr>
									<td>@rutina.NombreInstructor</td>
									<td>@rutina.NombreCliente</td>
									<td>@rutina.FechaRegistro</td>
									<td>@rutina.FechaInicio</td>
									<td>@rutina.FechaFin</td>
									<td>@rutina.Objetivo</td>
									<td>@rutina.DiasRutina</td>
									<td>@rutina.CantidadEjerciciosRegistrados</td>
								</tr>
							}
							</tbody>
							<tfoot>
							<tr>
								<th>@Html.DisplayNameFor(m => m.FirstOrDefault().NombreInstructor)</th>
								<th>@Html.DisplayNameFor(m => m.FirstOrDefault().NombreCliente)</th>
								<th>@Html.DisplayNameFor(m => m.FirstOrDefault().FechaRegistro)</th>
								<th>@Html.DisplayNameFor(m => m.FirstOrDefault().FechaInicio)</th>
								<th>@Html.DisplayNameFor(m => m.FirstOrDefault().FechaFin)</th>
								<th>@Html.DisplayNameFor(m => m.FirstOrDefault().Objetivo)</th>
								<th>@Html.DisplayNameFor(m => m.FirstOrDefault().DiasRutina)</th>
								<th>@Html.DisplayNameFor(m => m.FirstOrDefault().CantidadEjerciciosRegistrados)</th>
							</tr>
							</tfoot>
						</table>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

@section Scripts {
	<script type="text/javascript">
	$(document).ready(function ()
	{
		$('#example').DataTable({
			paging: true,
			ordering: true
		});

		@* $('#rutinas').DataTable({ *@
			@* dom: 'Bfrtip',
			buttons: [
				{
					extend: 'pdf',
					text: 'Exportar a PDF',
					filename: 'Reporte de rutinas',
					title: 'Reporte de rutinas',
					orientation: 'landscape'
				},
				{
					extend: 'excel',
					text: 'Exportar a Excel',
					filename: 'Reporte de rutinas',
					title: 'Reporte de rutinas'
				}
			], *@
			@* paging: false, *@
			@* ordering: false, *@
			@* info: false, *@
			@* searching: false *@
		@* }); *@
	});
</script>
}

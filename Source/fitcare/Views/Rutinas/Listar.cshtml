@model IEnumerable<RutinaViewModel>

@{
	ViewBag.Title = "Rutinas";
}

<div class="container">
	<div class="row">
		<div class="col-5 align-self-center">
			<h6 class="page-title">Mis rutinas</h6>
		</div>
		<div class="col-7 align-self-center">
			<div class="d-flex align-items-center justify-content-end">
				<nav aria-label="breadcrumb">
					<ol class="breadcrumb">
						<li class="breadcrumb-item">
							<a href="@Url.Action("Admin", "Home")">Administración</a>
						</li>
						<li class="breadcrumb-item active" aria-current="page">
							Rutinas
						</li>
					</ol>
				</nav>
			</div>
		</div>
	</div>
</div>

<div class="container-fluid">
	<div class="row">
		<div class="col-12">
			<div class="card shadow-sm">
				<div class="card-body">
					<div class="table-responsive">
						<table class="table table-hover table-sm text-nowrap">
							<thead>
								<tr>
									<th>@Html.DisplayNameFor(m => m.FirstOrDefault().Instructor)</th>
									<th>@Html.DisplayNameFor(m => m.FirstOrDefault().FechaRealizacion)</th>
									<th>@Html.DisplayNameFor(m => m.FirstOrDefault().FechaInicio)</th>
									<th>@Html.DisplayNameFor(m => m.FirstOrDefault().FechaFin)</th>
									<th>@Html.DisplayNameFor(m => m.FirstOrDefault().CantidadEjercicios)</th>
									<th>@Html.DisplayNameFor(m => m.FirstOrDefault().Objetivos)</th>
									<th></th>
								</tr>
							</thead>
							<tbody>
								@foreach (var Rutina in Model)
								{
									<tr>
										<td>@Rutina.Instructor</td>
										<td>@Rutina.FechaRealizacion.ToString("dd/MM/yyyy")</td>
										<td>@Rutina.FechaInicio.ToString("dd/MM/yyyy")</td>
										<td>@Rutina.FechaFin.ToString("dd/MM/yyyy")</td>
										<td>@Rutina.CantidadEjercicios</td>
										<td>@Rutina.Objetivos</td>
										<td class="text-right">
											<a class="btn btn-sm btn-light text-primary" asp-controller="Rutinas" asp-action="Detalle"
												asp-route-id="@Rutina.Id">Detalle</a>
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

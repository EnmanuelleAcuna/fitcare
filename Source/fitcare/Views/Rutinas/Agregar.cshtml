@model AgregarRutinaViewModel

@{
	ViewBag.Title = "Rutinas";
}

<div class="container">
	<div class="row">
		<div class="col-5 align-self-center">
			<h6 class="page-title">Agregar nueva rutina</h6>
		</div>
		<div class="col-7 align-self-center">
			<div class="d-flex align-items-center justify-content-end">
				<nav aria-label="breadcrumb">
					<ol class="breadcrumb">
						<li class="breadcrumb-item">
							<a asp-action="Admin" asp-controller="Home">Administración</a>
						</li>
						<li class="breadcrumb-item">
							<a asp-action="Rutinas">Rutinas</a>
						</li>
						<li class="breadcrumb-item active" aria-current="page">
							Agregar
						</li>
					</ol>
				</nav>
			</div>
		</div>
	</div>

	<div class="row">
		<div class="col-12">
			<div class="card shadow-sm">
				<div class="card-body">
					<form asp-action="Agregar" asp-controller="Rutinas" method="post" autocomplete="off">
						<div class="row">
							<div class="col-md-12">
								<div asp-validation-summary="ModelOnly"></div>
							</div>
						</div>

						<div class="row">
							<div class="col-sm-12 col-md-6">
								<div class="form-group">
									<label asp-for="IdInstructor"></label>
									<select asp-for="IdInstructor" asp-items="@(new List<SelectListItem>(ViewBag.ListaInstructores))" class="form-control form-control-sm">
										<option value="">Seleccione un instructor</option>
									</select>
									<span asp-validation-for="IdInstructor"></span>
								</div>
							</div>

							<div class="col-sm-12 col-md-6">
								<div class="form-group">
									<label asp-for="IdCliente"></label>
									<select asp-for="IdCliente" asp-items="@(new List<SelectListItem>(ViewBag.ListaClientes))" class="form-control form-control-sm">
										<option value="">Seleccione un cliente</option>
									</select>
									<span asp-validation-for="IdCliente"></span>
								</div>
							</div>
						</div>

						<div class="row">
							<div class="col-sm-12 col-md-6">
								<div class="form-group">
									<label asp-for="FechaInicio"></label>
									<input asp-for="FechaInicio" class="form-control form-control-sm" />
									<span asp-validation-for="FechaInicio" class="text-danger"></span>
								</div>
							</div>

							<div class="col-sm-12 col-md-6">
								<div class="form-group">
									<label asp-for="FechaFin"></label>
									<input asp-for="FechaFin" class="form-control form-control-sm" />
									<span asp-validation-for="FechaFin" class="text-danger"></span>
								</div>
							</div>
						</div>

						<div class="row">
							<div class="col-sm-12">
								<div class="form-group">
									<label asp-for="Objetivo"></label>
									<textarea asp-for="Objetivo" rows="4" class="form-control form-control-sm" placeholder="Digite el objetivo de la rutina"></textarea>
									<span asp-validation-for="Objetivo" class="text-danger"></span>
								</div>
							</div>
						</div>

						<div class="row mt-2">
							<div class="col-12">
								<button class="btn btn-sm btn-primary" type="submit">Guardar rutina</button>
								<a asp-action="Rutinas" class="btn btn-sm btn-secondary">Regresar</a>
							</div>
						</div>
					</form>
				</div>
			</div>
		</div>
	</div>
</div>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}

@model DetalleRutinaViewModel

@{
	ViewBag.Title = "Rutinas";
}

<div class="container">
	<div class="row">
		<div class="col-5 align-self-center">
			<h6 class="page-title">Detalle de rutina</h6>
		</div>
		<div class="col-7 align-self-center">
			<div class="d-flex align-items-center justify-content-end">
				<nav aria-label="breadcrumb">
					<ol class="breadcrumb">
						<li class="breadcrumb-item">
							<a href="@Url.Action("Administracion", "Home")">Administración</a>
						</li>

						<li class="breadcrumb-item">
							<a href='@Url.Action("Listar")'>Rutinas</a>
						</li>
						<li class="breadcrumb-item active" aria-current="page">
							Detalle
						</li>
					</ol>
				</nav>
			</div>
		</div>
	</div>
</div>

<div class="container-fluid">
	<div class="row">
		<div class="col-12">
			<div class="card shadow-sm">
				<div class="card-body">
					<div class="table-responsive">
						<table class="table table-hover table-sm text-nowrap">
							<thead>
								<tr>
									<th>@Html.DisplayNameFor(m => m.Instructor)</th>
									<th>@Html.DisplayNameFor(m => m.Cliente)</th>
									<th>@Html.DisplayNameFor(m => m.FechaRealizacion)</th>
									<th>@Html.DisplayNameFor(m => m.FechaInicio)</th>
									<th>@Html.DisplayNameFor(m => m.FechaFin)</th>
									<th>@Html.DisplayNameFor(m => m.CantidadEjercicios)</th>
									<th>@Html.DisplayNameFor(m => m.Objetivos)</th>
								</tr>
							</thead>
							<tbody>
								<tr>
									<td>@Model.Instructor</td>
									<td>@Model.Cliente</td>
									<td>@Model.FechaRealizacion.ToString("dd/MM/yyyy")</td>
									<td>@Model.FechaInicio.ToString("dd/MM/yyyy")</td>
									<td>@Model.FechaFin.ToString("dd/MM/yyyy")	</td>
									<td>@Model.CantidadEjercicios</td>
									<td>@Model.Objetivos</td>
								</tr>
							</tbody>
						</table>

						<table class="table table-hover table-sm text-nowrap">
							<thead>
								<tr>
									<th>@Html.DisplayNameFor(m => m.Ejercicios.FirstOrDefault().NombreEjercicio)</th>
									<th>@Html.DisplayNameFor(m => m.Ejercicios.FirstOrDefault().NombreMaquina)</th>
									<th>@Html.DisplayNameFor(m => m.Ejercicios.FirstOrDefault().Series)</th>
									<th>@Html.DisplayNameFor(m => m.Ejercicios.FirstOrDefault().Repeticiones)</th>
									<th>@Html.DisplayNameFor(m => m.Ejercicios.FirstOrDefault().MinutosDescanso)</th>
								</tr>
							</thead>
							<tbody>
								@foreach (var ejercicio in Model.Ejercicios)
								{
									<tr>
										<td>@ejercicio.NombreEjercicio</td>
										<td>@ejercicio.NombreMaquina</td>
										<td>@ejercicio.Series</td>
										<td>@ejercicio.Repeticiones</td>
										<td>@ejercicio.MinutosDescanso</td>
									</tr>
								}
							</tbody>
						</table>

						<table class="table table-hover table-sm text-nowrap">
							<thead>
								<tr>
									<th>@Html.DisplayNameFor(m => m.Medidas.FirstOrDefault().NombreTipoMedida)</th>
									<th>@Html.DisplayNameFor(m => m.Medidas.FirstOrDefault().Valor)</th>
									<th>@Html.DisplayNameFor(m => m.Medidas.FirstOrDefault().Comentario)</th>
								</tr>
							</thead>
							<tbody>
								@foreach (var medida in Model.Medidas)
								{
									<tr>
										<td>@medida.NombreTipoMedida</td>
										<td>@medida.Valor</td>
										<td>@medida.Comentario</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

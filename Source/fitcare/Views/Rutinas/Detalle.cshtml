@model DetalleRutinaViewModel

@{
	ViewBag.Title = "Rutinas";
}

<div class="container">
	<div class="row">
		<div class="col-5 align-self-center">
			<h6 class="page-title">Detalle de rutina</h6>
		</div>
		<div class="col-7 align-self-center">
			<div class="d-flex align-items-center justify-content-end">
				<nav aria-label="breadcrumb">
					<ol class="breadcrumb">
						<li class="breadcrumb-item">
							<a asp-action="Admin" asp-controller="Home">Administración</a>
						</li>
						<li class="breadcrumb-item">
							<a asp-action="Rutinas">Rutinas</a>
						</li>
						<li class="breadcrumb-item active" aria-current="page">
							Detalle
						</li>
					</ol>
				</nav>
			</div>
		</div>
	</div>

	<div class="row mb-4">
		<div class="col-12">
			<div class="card shadow-sm">
				<div class="card-body">
					<div class="d-flex justify-content-between align-items-center">
						<h6 class="mb-0 font-weight-bold">Información básica de rutina</h6>
						<a asp-action="ExportarRutina" asp-route-id="@Model.Id" class="btn btn-sm btn-success">
							<i class="fas fa-file-excel"></i> Exportar a Excel
						</a>
					</div>
					<hr/>

					<div class="row">
						<div class="col-md-6">
							<div class="form-group">
								<label>@Html.DisplayNameFor(m => m.Instructor)</label>
								<input type="text" class="form-control form-control-sm" value="@Model.Instructor" readonly/>
							</div>
						</div>
						<div class="col-md-6">
							<div class="form-group">
								<label>@Html.DisplayNameFor(m => m.Cliente)</label>
								<input type="text" class="form-control form-control-sm" value="@Model.Cliente" readonly/>
							</div>
						</div>
					</div>

					<div class="row">
						<div class="col-md-6">
							<div class="form-group">
								<label>@Html.DisplayNameFor(m => m.FechaInicio)</label>
								<input type="text" class="form-control form-control-sm" value="@Model.FechaInicio.ToString("dd/MM/yyyy")" readonly/>
							</div>
						</div>
						<div class="col-md-6">
							<div class="form-group">
								<label>@Html.DisplayNameFor(m => m.FechaFin)</label>
								<input type="text" class="form-control form-control-sm" value="@Model.FechaFin.ToString("dd/MM/yyyy")" readonly/>
							</div>
						</div>
					</div>

					<div class="row">
						<div class="col-12">
							<div class="form-group">
								<label>Objetivos</label>
								<textarea class="form-control form-control-sm" rows="3" readonly>@Model.Objetivos</textarea>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>

	<div class="row mb-4">
		<div class="col-12">
			<div class="card shadow-sm">
				<div class="card-body">
					<h6 class="mb-3 font-weight-bold">Ejercicios</h6>

					<table class="table table-hover table-sm" id="tablaEjercicios">
						<thead>
						<tr>
							<th>Ejercicio</th>
							<th class="text-nowrap">@Html.DisplayNameFor(m => m.Ejercicios.FirstOrDefault().GruposMusculares)</th>
							<th>@Html.DisplayNameFor(m => m.Ejercicios.FirstOrDefault().Maquinas)</th>
							<th>@Html.DisplayNameFor(m => m.Ejercicios.FirstOrDefault().Series)</th>
							<th>@Html.DisplayNameFor(m => m.Ejercicios.FirstOrDefault().Repeticiones)</th>
							<th>Descanso</th>
						</tr>
						</thead>
						<tbody>
						@foreach (var ejercicio in Model.Ejercicios)
						{
							<tr>
								<td>@ejercicio.NombreEjercicio</td>
								<td>@ejercicio.GruposMusculares</td>
								<td>@ejercicio.Maquinas</td>
								<td>@ejercicio.Series</td>
								<td>@ejercicio.Repeticiones</td>
								<td>@ejercicio.MinutosDescanso @(ejercicio.MinutosDescanso == 1 ? "minuto" : "minutos")</td>
							</tr>
						}
						</tbody>
					</table>
				</div>
			</div>
		</div>
	</div>

	<div class="row">
		<div class="col-12">
			<div class="card shadow-sm">
				<div class="card-body">
					<h6 class="mb-3 font-weight-bold">Medidas</h6>

					<table class="table table-hover table-sm text-nowrap" id="tablaMedidas">
						<thead>
						<tr>
							<th>Tipo de medida</th>
							<th>@Html.DisplayNameFor(m => m.Medidas.FirstOrDefault().Valor)</th>
							<th>@Html.DisplayNameFor(m => m.Medidas.FirstOrDefault().Comentario)</th>
						</tr>
						</thead>
						<tbody>
						@foreach (var medida in Model.Medidas)
						{
							<tr>
								<td>@medida.NombreTipoMedida</td>
								<td>@medida.Valor</td>
								<td>@medida.Comentario</td>
							</tr>
						}
						</tbody>
					</table>
				</div>
			</div>
		</div>
	</div>
</div>

@* Modal Editar Medida *@
<div class="modal fade" id="ModalEditarMedida" tabindex="-1" role="dialog">
	<div class="modal-dialog" role="document">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title">Editar medida</h5>
				<button type="button" class="close" data-dismiss="modal">
					<span>&times;</span>
				</button>
			</div>
			<form id="formEditarMedida">
				<div class="modal-body">
					<div class="alert alert-danger d-none" id="errorEditarMedida"></div>

					<input type="hidden" id="IdMedidaRutinaEditar"/>

					<div class="form-group">
						<label for="IdTipoMedidaEditar">Tipo de medida</label>
						<select id="IdTipoMedidaEditar" name="IdTipoMedida" class="form-control form-control-sm"
						        required>
							<option value="">Seleccione un tipo de medida</option>
							@foreach (var tipoMedida in (List<SelectListItem>)ViewBag.ListaTiposMedida)

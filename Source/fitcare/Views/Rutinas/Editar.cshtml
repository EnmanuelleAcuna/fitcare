@section Scripts {
	<script type="text/javascript">
		// Arrays de IDs ya agregados (desde el servidor)
		var ejerciciosAgregados = @Html.Raw(Json.Serialize(ViewBag.EjerciciosAgregados));
		var tiposMedidaAgregados = @Html.Raw(Json.Serialize(ViewBag.TiposMedidaAgregados));

		// Enviar formulario de encabezado
		$('#formEncabezado').on('submit', function (e) {
			e.preventDefault();
			$('#btnGuardarEncabezado').prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i> Guardando...');

			// Limpiar errores previos
			$('#errorEncabezado').addClass('d-none').text('');
			$('.text-danger').addClass('d-none').text('');

			var formData = {
				IdRutina: $('#IdRutina').val(),
				FechaInicio: $('#FechaInicio').val(),
				FechaFin: $('#FechaFin').val(),
				Objetivos: $('#Objetivos').val()
			};

			$.ajax({
				url: '@Url.Action("EditarEncabezadoAjax")',
				type: 'POST',
				data: JSON.stringify(formData),
				contentType: 'application/json',
				success: function (response) {
					if (response.success) {
						mostrarToast(response.message, 'success');
					} else if (response.errors) {
						for (var key in response.errors) {
							$('#error' + key).removeClass('d-none').text(response.errors[key]);
						}
					} else {
						$('#errorEncabezado').removeClass('d-none').text(response.message);
					}
				},
				error: function () {
					$('#errorEncabezado').removeClass('d-none').text('Error al comunicarse con el servidor.');
				},
				complete: function () {
					$('#btnGuardarEncabezado').prop('disabled', false).html('<i class="fa fa-save"></i> Guardar cambios');
				}
			});
		});

		// Función para filtrar opciones del select
		function filtrarOpcionesEjercicios() {
			$('#IdEjercicioAgregar option').each(function () {
				var optionValue = $(this).val();
				if (optionValue && ejerciciosAgregados.includes(optionValue)) {
					$(this).prop('disabled', true).hide();
				} else {
					$(this).prop('disabled', false).show();
				}
			});
		}

		function filtrarOpcionesTiposMedida() {
			$('#IdTipoMedidaAgregar option').each(function () {
				var optionValue = $(this).val();
				if (optionValue && tiposMedidaAgregados.includes(optionValue)) {
					$(this).prop('disabled', true).hide();
				} else {
					$(this).prop('disabled', false).show();
				}
			});
		}

		// Inicializar Select2 para ejercicios
		$(document).ready(function () {
			// Filtrar opciones antes de inicializar Select2
			filtrarOpcionesEjercicios();
			filtrarOpcionesTiposMedida();

			$('#IdEjercicioAgregar').select2({
				dropdownParent: $('#ModalAgregarEjercicio'),
				width: '100%'
			});

			$('#IdEjercicioEditar').select2({
				dropdownParent: $('#ModalEditarEjercicio'),
				width: '100%'
			});
		});

		// Limpiar errores al cerrar modales
		$('#ModalAgregarEjercicio').on('hidden.bs.modal', function () {
			$('#formAgregarEjercicio')[0].reset();
			$('#IdEjercicioAgregar').val(null).trigger('change');
			$('#errorAgregarEjercicio').addClass('d-none').text('');
			$('.text-danger').addClass('d-none').text('');
		});

		$('#ModalAgregarMedida').on('hidden.bs.modal', function () {
			$('#formAgregarMedida')[0].reset();
			$('#errorAgregarMedida').addClass('d-none').text('');
			$('.text-danger').addClass('d-none').text('');
		});

		$('#ModalEditarEjercicio').on('hidden.bs.modal', function () {
			$('#formEditarEjercicio')[0].reset();
			$('#IdEjercicioEditar').val(null).trigger('change');
			$('#errorEditarEjercicio').addClass('d-none').text('');
			$('.text-danger').addClass('d-none').text('');
		});

		$('#ModalEditarMedida').on('hidden.bs.modal', function () {
			$('#formEditarMedida')[0].reset();
			$('#errorEditarMedida').addClass('d-none').text('');
			$('.text-danger').addClass('d-none').text('');
		});

		// Abrir modal de editar ejercicio
		$(document).on('click', '.btn-editar-ejercicio', function () {
			var btn = $(this);
			var ejercicioActual = btn.data('idejercicio').toString();

			// Filtrar ejercicios pero permitir el que estamos editando
			$('#IdEjercicioEditar option').each(function () {
				var optionValue = $(this).val();
				if (optionValue && ejerciciosAgregados.includes(optionValue) && optionValue !== ejercicioActual) {
					$(this).prop('disabled', true).hide();
				} else {
					$(this).prop('disabled', false).show();
				}
			});

			$('#IdEjercicioRutinaEditar').val(btn.data('id'));
			$('#IdEjercicioEditar').val(ejercicioActual).trigger('change');
			$('#SeriesEditar').val(btn.data('series'));
			$('#RepeticionesEditar').val(btn.data('repeticiones'));
			$('#MinutosDescansoEditar').val(btn.data('minutos'));
			$('#ModalEditarEjercicio').modal('show');
		});

		// Abrir modal de editar medida
		$(document).on('click', '.btn-editar-medida', function () {
			var btn = $(this);
			var tipoMedidaActual = btn.data('idtipomedida').toString();

			// Filtrar tipos de medida pero permitir el que estamos editando
			$('#IdTipoMedidaEditar option').each(function () {
				var optionValue = $(this).val();
				if (optionValue && tiposMedidaAgregados.includes(optionValue) && optionValue !== tipoMedidaActual) {
					$(this).prop('disabled', true).hide();
				} else {
					$(this).prop('disabled', false).show();
				}
			});

			$('#IdMedidaRutinaEditar').val(btn.data('id'));
			$('#IdTipoMedidaEditar').val(tipoMedidaActual);
			$('#ValorEditar').val(btn.data('valor'));
			$('#ComentarioEditar').val(btn.data('comentario'));
			$('#ModalEditarMedida').modal('show');
		});

		// Enviar formulario de agregar ejercicio
		$('#formAgregarEjercicio').on('submit', function (e) {
			e.preventDefault();
			$('#btnGuardarEjercicio').prop('disabled', true).text('Guardando...');

			// Limpiar errores previos
			$('#errorAgregarEjercicio').addClass('d-none').text('');
			$('.text-danger').addClass('d-none').text('');

			var formData = {
				IdRutina: $('#IdRutinaEjercicio').val(),
				IdEjercicio: $('#IdEjercicioAgregar').val(),
				Series: parseInt($('#SeriesAgregar').val()),
				Repeticiones: parseInt($('#RepeticionesAgregar').val()),
				MinutosDescanso: parseInt($('#MinutosDescansoAgregar').val())
			};

			$.ajax({
				url: '@Url.Action("AgregarEjercicioAjax")',
				type: 'POST',
				data: JSON.stringify(formData),
				contentType: 'application/json',
				success: function (response) {
					if (response.success) {
						$('#ModalAgregarEjercicio').modal('hide');
						mostrarToast(response.message, 'success');
						setTimeout(function () {
							location.reload();
						}, 1000);
					} else if (response.errors) {
						// Mostrar errores de validación
						for (var key in response.errors) {
							$('#error' + key).removeClass('d-none').text(response.errors[key]);
						}
					} else {
						$('#errorAgregarEjercicio').removeClass('d-none').text(response.message);
					}
				},
				error: function () {
					$('#errorAgregarEjercicio').removeClass('d-none').text('Error al comunicarse con el servidor.');
				},
				complete: function () {
					$('#btnGuardarEjercicio').prop('disabled', false).text('Guardar');
				}
			});
		});


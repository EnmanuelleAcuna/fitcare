		// Eliminar ejercicio
		$(document).on('click', '.btn-eliminar-ejercicio', function () {
			if (!confirm('¿Está seguro de eliminar este ejercicio?')) return;

			var idEjercicio = $(this).data('id');
			var btn = $(this);
			btn.prop('disabled', true).text('Eliminando...');

			$.ajax({
				url: '@Url.Action("EliminarEjercicioAjax")',
				type: 'POST',
				data: JSON.stringify({IdEjercicioRutina: idEjercicio}),
				contentType: 'application/json',
				success: function (response) {
					if (response.success) {
						location.reload();
					} else {
						alert(response.message);
						btn.prop('disabled', false).text('Eliminar');
					}
				},
				error: function () {
					alert('Error al eliminar el ejercicio.');
					btn.prop('disabled', false).text('Eliminar');
				}
			});
		});


@model DetalleRutinaViewModel

@{
	ViewBag.Title = "Rutinas";
}

<div class="container">
	<div class="row">
		<div class="col-5 align-self-center">
			<h6 class="page-title">Editar rutina</h6>
		</div>
		<div class="col-7 align-self-center">
			<div class="d-flex align-items-center justify-content-end">
				<nav aria-label="breadcrumb">
					<ol class="breadcrumb">
						<li class="breadcrumb-item">
							<a asp-action="Admin" asp-controller="Home">Administración</a>
						</li>

						<li class="breadcrumb-item">
							<a asp-action="Rutinas">Rutinas</a>
						</li>
						<li class="breadcrumb-item active" aria-current="page">
							Editar
						</li>
					</ol>
				</nav>
			</div>
		</div>
	</div>

	<div class="row mb-4">
		<div class="col-12">
			<div class="card shadow-sm">
				<div class="card-body">
					<h6 class="mb-0 font-weight-bold">Información básica de rutina</h6>
					<hr/>
					<form id="formEncabezado">
						<input type="hidden" id="IdRutina" value="@Model.Id"/>

						<div class="row">
							<div class="col-md-6">
								<div class="form-group">
									<label>@Html.DisplayNameFor(m => m.Instructor)</label>
									<input type="text" class="form-control form-control-sm" value="@Model.Instructor"
									       readonly/>
								</div>
							</div>
							<div class="col-md-6">
								<div class="form-group">
									<label>@Html.DisplayNameFor(m => m.Cliente)</label>
									<input type="text" class="form-control form-control-sm" value="@Model.Cliente"
									       readonly/>
								</div>
							</div>
						</div>

						<div class="row">
							<div class="col-md-6">
								<div class="form-group">
									<label for="FechaInicio">@Html.DisplayNameFor(m => m.FechaInicio)</label>
									<input type="date" class="form-control form-control-sm" id="FechaInicio"
									       name="FechaInicio"
									       value="@Model.FechaInicio.ToString("yyyy-MM-dd")" required/>
									<span class="text-danger d-none" id="errorFechaInicio"></span>
								</div>
							</div>
							<div class="col-md-6">
								<div class="form-group">
									<label for="FechaFin">@Html.DisplayNameFor(m => m.FechaFin)</label>
									<input type="date" class="form-control form-control-sm" id="FechaFin"
									       name="FechaFin"
									       value="@Model.FechaFin.ToString("yyyy-MM-dd")" required/>
									<span class="text-danger d-none" id="errorFechaFin"></span>
								</div>
							</div>
						</div>

						<div class="row">
							<div class="col-12">
								<div class="form-group">
									<label for="Objetivos">Objetivos</label>
									<textarea class="form-control form-control-sm" id="Objetivos" name="Objetivos"
									          rows="3" maxlength="1000">@Model.Objetivos</textarea>
									<span class="text-danger d-none" id="errorObjetivos"></span>
								</div>
							</div>
						</div>

						<div class="row">
							<div class="col-12">
								<div class="alert alert-danger d-none" id="errorEncabezado"></div>
							</div>
						</div>

						<div class="row">
							<div class="col-12">
								<button type="submit" class="btn btn-sm btn-primary" id="btnGuardarEncabezado">
									<i class="fa fa-save"></i> Guardar cambios
								</button>
							</div>
						</div>
					</form>
				</div>
			</div>
		</div>
	</div>
	
	<div class="row mb-4">
		<div class="col-12">
			<div class="card shadow-sm">
				<div class="card-body">
					<div class="d-flex justify-content-between align-items-center mb-2">
						<h6 class="mb-0 font-weight-bold">Ejercicios</h6>
						<button class="btn btn-sm btn-primary" data-toggle="modal" data-target="#ModalAgregarEjercicio">
							Agregar ejercicio
						</button>
					</div>

					<table class="table table-hover table-sm" id="tablaEjercicios">
						<thead>
						<tr>
							<th>Ejercicio</th>
							<th class="text-nowrap">@Html.DisplayNameFor(m => m.Ejercicios.FirstOrDefault().GruposMusculares)</th>
							<th>@Html.DisplayNameFor(m => m.Ejercicios.FirstOrDefault().Maquinas)</th>
							<th>@Html.DisplayNameFor(m => m.Ejercicios.FirstOrDefault().Series)</th>
							<th>@Html.DisplayNameFor(m => m.Ejercicios.FirstOrDefault().Repeticiones)</th>
							<th>Descanso</th>
							<th></th>
						</tr>
						</thead>
						<tbody>
						@foreach (var ejercicio in Model.Ejercicios)
						{
							<tr>
								<td>@ejercicio.NombreEjercicio</td>
								<td>@ejercicio.GruposMusculares</td>
								<td>@ejercicio.Maquinas</td>
								<td>@ejercicio.Series</td>
								<td>@ejercicio.Repeticiones</td>
								<td>@ejercicio.MinutosDescanso</td>
								<td class="text-right text-nowrap">
									<button class="btn btn-sm btn-light btn-editar-ejercicio"
									        data-id="@ejercicio.Id"
									        data-idejercicio="@ejercicio.IdEjercicio"
									        data-series="@ejercicio.Series"
									        data-repeticiones="@ejercicio.Repeticiones"
									        data-minutos="@ejercicio.MinutosDescanso">
										Editar
									</button>
									<button class="btn btn-sm btn-danger btn-eliminar-ejercicio"
									        data-id="@ejercicio.Id">
										Eliminar
									</button>
								</td>
							</tr>
						}
						</tbody>
					</table>
				</div>
			</div>
		</div>
	</div>
	
	<div class="row">
		<div class="col-12">
			<div class="card shadow-sm">
				<div class="card-body">
					<div class="d-flex justify-content-between align-items-center mb-2">
						<h6 class="mb-0 font-weight-bold">Medidas</h6>
						<button class="btn btn-sm btn-primary" data-toggle="modal" data-target="#ModalAgregarMedida">
							Agregar medida
						</button>
					</div>

					<table class="table table-hover table-sm text-nowrap" id="tablaMedidas">
						<thead>
						<tr>
							<th>Tipo de medida</th>
							<th>@Html.DisplayNameFor(m => m.Medidas.FirstOrDefault().Valor)</th>
							<th>@Html.DisplayNameFor(m => m.Medidas.FirstOrDefault().Comentario)</th>
							<th></th>
						</tr>
						</thead>
						<tbody>
						@foreach (var medida in Model.Medidas)
						{
							<tr>
								<td>@medida.NombreTipoMedida</td>
								<td>@medida.Valor</td>
								<td>@medida.Comentario</td>
								<td class="text-right">
									<button class="btn btn-sm btn-light btn-editar-medida"
									        data-id="@medida.Id"
									        data-idtipomedida="@medida.IdTipoMedida"
									        data-valor="@medida.Valor"
									        data-comentario="@medida.Comentario">
										Editar
									</button>
									<button class="btn btn-sm btn-danger btn-eliminar-medida" data-id="@medida.Id">
										Eliminar
									</button>
								</td>
							</tr>
						}
						</tbody>
					</table>
				</div>
			</div>
		</div>
	</div>
</div>

@* Modal Agregar Ejercicio *@
<div class="modal fade" id="ModalAgregarEjercicio" tabindex="-1" role="dialog">
	<div class="modal-dialog" role="document">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title">Agregar ejercicio</h5>
				<button type="button" class="close" data-dismiss="modal">
					<span>&times;</span>
				</button>
			</div>
			<form id="formAgregarEjercicio">
				<div class="modal-body">
					<div class="alert alert-danger d-none" id="errorAgregarEjercicio"></div>

					<input type="hidden" id="IdRutinaEjercicio" value="@Model.Id"/>

					<div class="form-group">
						<label for="IdEjercicioAgregar">Ejercicio</label>
						<select id="IdEjercicioAgregar" name="IdEjercicio" class="form-control form-control-sm select2"
						        required>
							<option value="">Seleccione un ejercicio</option>
							@foreach (var ejercicio in (List<SelectListItem>)ViewBag.ListaEjercicios)
							{
								<option value="@ejercicio.Value">@ejercicio.Text</option>
							}
						</select>
						<small class="text-danger d-none" id="errorIdEjercicio"></small>
					</div>

					<div class="form-group">
						<label for="SeriesAgregar">Series</label>
						<input type="number" id="SeriesAgregar" name="Series" class="form-control form-control-sm"
						       min="1" max="100" required/>
						<small class="text-danger d-none" id="errorSeries"></small>
					</div>

					<div class="form-group">
						<label for="RepeticionesAgregar">Repeticiones</label>
						<input type="number" id="RepeticionesAgregar" name="Repeticiones"
						       class="form-control form-control-sm" min="1" max="500" required/>
						<small class="text-danger d-none" id="errorRepeticiones"></small>
					</div>

					<div class="form-group">
						<label for="MinutosDescansoAgregar">Minutos de descanso</label>
						<input type="number" id="MinutosDescansoAgregar" name="MinutosDescanso"
						       class="form-control form-control-sm" min="0" max="60" required/>
						<small class="text-danger d-none" id="errorMinutosDescanso"></small>
					</div>
				</div>
				<div class="modal-footer">
					<button type="button" class="btn btn-secondary btn-sm" data-dismiss="modal">Cancelar</button>
					<button type="submit" class="btn btn-primary btn-sm" id="btnGuardarEjercicio">Guardar</button>
				</div>
			</form>
		</div>
	</div>
</div>


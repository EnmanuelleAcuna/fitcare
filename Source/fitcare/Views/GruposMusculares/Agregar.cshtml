@model AgregarGrupoMuscularViewModel

@{
	ViewBag.Title = "Grupos musculares";
}

<div class="container">
	<div class="row">
		<div class="col-5 align-self-center">
			<h6 class="page-title">Agregar nuevo grupo muscular</h6>
		</div>
		<div class="col-7 align-self-center">
			<div class="d-flex align-items-center justify-content-end">
				<nav aria-label="breadcrumb">
					<ol class="breadcrumb">
						<li class="breadcrumb-item">
							<a asp-action="Admin" asp-controller="Home">Administración</a>
						</li>
						<li class="breadcrumb-item">
							<a asp-action="Listar">Grupos musculares</a>
						</li>
						<li class="breadcrumb-item active" aria-current="page">
							Agregar
						</li>
					</ol>
				</nav>
			</div>
		</div>
	</div>

	<div class="row">
		<div class="col-12">
			<div class="card shadow-sm">
				<div class="card-body">
					<form asp-action="Agregar" asp-controller="GruposMusculares" method="post" autocomplete="off">
						<div class="row">
							<div class="col-md-12">
								<div asp-validation-summary="ModelOnly"></div>
							</div>
						</div>

						<div class="row">
							<div class="col-sm-12 col-md-4">
								<div class="form-group">
									<label asp-for="Nombre"></label>
									<input asp-for="Nombre" class="form-control form-control-sm" placeholder="Digite el nombre del nuevo grupo muscular" />
									<span asp-validation-for="Nombre"></span>
								</div>
							</div>

							<div class="col-sm-12 col-md-4">
								<div class="form-group">
									<label asp-for="Estado"></label>
									<br />
									<input asp-for="Estado" type="checkbox" />
								</div>
							</div>

							<div class="col-12">
								<div class="form-group">
									<label asp-for="Descripcion"></label>
									<textarea asp-for="Descripcion" rows="4" class="form-control form-control-sm" placeholder="Descripcion del nuevo grupo muscular"></textarea>
									<span asp-validation-for="Descripcion"></span>
								</div>
							</div>

							<div class="col-12">
								<button type="submit" class="btn btn-sm btn-primary">Guardar</button>
								<a asp-action="Listar" class="btn btn-sm btn-secondary">Regresar</a>
							</div>
						</div>
					</form>
				</div>
			</div>
		</div>
	</div>
</div>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}

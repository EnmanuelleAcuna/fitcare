@model EliminarGrupoMuscularViewModel

@{
	ViewBag.Title = "GruposMusculares";
}

<div class="container">
	<div class="row">
		<div class="col-5 align-self-center">
			<h6 class="page-title">Eliminar grupo muscular</h6>
		</div>
		<div class="col-7 align-self-center">
			<div class="d-flex align-items-center justify-content-end">
				<nav aria-label="breadcrumb">
					<ol class="breadcrumb">
						<li class="breadcrumb-item">
							<a asp-action="Admin" asp-controller="Home">Administración</a>
						</li>
						<li class="breadcrumb-item">
							<a asp-action="Listar">Grupos musculares</a>
						</li>
						<li class="breadcrumb-item active" aria-current="page">
							Eliminar
						</li>
					</ol>
				</nav>
			</div>
		</div>
	</div>

	<div class="row">
		<div class="col-12">
			<div class="card shadow-sm">
				<div class="card-body">
					<form asp-action="Eliminar" asp-controller="GruposMusculares" method="post" autocomplete="off">
						<input asp-for="IdGrupoMuscular" type="hidden" />

						<div class="row">
							<div class="col-md-12">
								<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
							</div>
						</div>

						<div class="row">
							<div class="col-sm-12">
								<h6>
									¿Seguro que desea eliminar el grupo muscular
									<b>@Model.Nombre</b>?
								</h6>
							</div>

							<div class="col-12">
								<button type="submit" class="btn btn-sm btn-danger">Eliminar</button>
								<a asp-action="Listar" class="btn btn-sm btn-secondary">Regresar</a>
							</div>
						</div>
					</form>
				</div>
			</div>
		</div>
	</div>
</div>

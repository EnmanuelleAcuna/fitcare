@model IEnumerable<ProvinciaViewModel>

@{
	ViewBag.Title = "Provincias";
}

<div class="container">
	<div class="row">
		<div class="col-5 align-self-center">
			<h6 class="page-title">Lista de provincias</h6>
		</div>
		<div class="col-7 align-self-center">
			<div class="d-flex align-items-center justify-content-end">
				<nav aria-label="breadcrumb">
					<ol class="breadcrumb">
						<li class="breadcrumb-item">
							<a asp-action="Administracion" asp-controller="Home">Administración</a>
						</li>
						<li class="breadcrumb-item active" aria-current="page">
							Provincias
						</li>
					</ol>
				</nav>
			</div>
		</div>
	</div>
</div>

<div class="container-fluid">
	<div class="row">
		<div class="col-12">
			<div class="card shadow-sm">
				<div class="card-body">
					<a asp-action="AgregarProvincia" class="btn btn-sm btn-secondary">Agregar</a>

					<hr />

					<div class="table-responsive">
						<table class="table table-hover table-sm text-nowrap">
							<thead>
								<tr>
									<th>@Html.DisplayNameFor(m => m.FirstOrDefault().Nombre)</th>
									<th>@Html.DisplayNameFor(m => m.FirstOrDefault().Estado)</th>
									<th></th>
								</tr>
							</thead>
							<tbody>
								@foreach (var Provincia in Model)
								{
									<tr>
										<td>@Provincia.Nombre</td>
										<td>@Provincia.Estado</td>
										<td class="text-right">
											<div class="btn-group btn-group-sm" role="group" aria-label="Basic example">
												<a class="btn btn-sm btn-light" asp-controller="DivisionTerritorial" asp-action="EditarProvincia"
													asp-route-id="@Provincia.Id">Modificar</a>
												<a class="btn btn-sm btn-light text-danger" asp-controller="DivisionTerritorial" asp-action="EliminarProvincia"
													asp-route-id="@Provincia.Id">Eliminar</a>
											</div>
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

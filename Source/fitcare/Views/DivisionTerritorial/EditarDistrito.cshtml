@model EditarDistritoViewModel

@{
	ViewBag.Title = "Distritos";
}

<div class="page-breadcrumb">
	<div class="row">
		<div class="col-5 align-self-center">
			<h4 class="page-title">Modificar distrito</h4>
		</div>
		<div class="col-7 align-self-center">
			<div class="d-flex align-items-center justify-content-end">
				<nav aria-label="breadcrumb">
					<ol class="breadcrumb">
						<li class="breadcrumb-item">
							<a asp-action="Administracion" asp-controller="Home">Administración</a>
						</li>
						<li class="breadcrumb-item">
							<a asp-action="Distritos">Distritos</a>
						</li>
						<li class="breadcrumb-item active" aria-current="page">
							Modificar
						</li>
					</ol>
				</nav>
			</div>
		</div>
	</div>
</div>

<div class="container-fluid">
	<div class="row">
		<div class="col-12">
			<div class="card shadow-sm">
				<div class="card-body">
					<form asp-action="EditarDistrito" asp-controller="DivisionTerritorial" method="post" autocomplete="off">
						<input asp-for="Id" type="hidden" />

						<div class="row">
							<div class="col-md-12">
								<div asp-validation-summary="ModelOnly"></div>
							</div>
						</div>

						<div class="row">
							<div class="col-sm-12 col-md-4">
								<div class="form-group">
									<label asp-for="Nombre"></label>
									<input asp-for="Nombre" class="form-control form-control-sm" />
									<span asp-validation-for="Nombre"></span>
								</div>
							</div>

							<div class="col-sm-12 col-md-3">
								<div class="form-group">
									<label asp-for="IdCanton"></label>
									<select asp-for="IdCanton" asp-items="@(new List<SelectListItem>(ViewBag.ListaCantones))" class="form-control form-control-sm">
										<option value="">Seleccione un canton</option>
									</select>
									<span asp-validation-for="IdCanton"></span>
								</div>
							</div>

							<div class="col-sm-12 col-md-2">
								<div class="form-group">
									<label asp-for="IdINEC"></label>
									<input asp-for="IdINEC" class="form-control form-control-sm" />
									<span asp-validation-for="IdINEC"></span>
								</div>
							</div>

							<div class="col-sm-12 col-md-3">
								<div class="form-group">
									<label asp-for="Activo"></label>
									<br />
									<input asp-for="Activo" type="checkbox" />
								</div>
							</div>

							<div class="col-12">
								<button type="submit" class="btn btn-sm btn-default">Guardar</button>
								<a asp-action="Distritos" class="btn btn-sm btn-secondary">Regresar</a>
							</div>
						</div>
					</form>
				</div>
			</div>
		</div>
	</div>
</div>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}

@using fitcare.Models.Identity

@inject SignInManager<ApplicationUser> SignInManager

<!DOCTYPE html>
<html lang="es">

<head>
	<meta charset="utf-8"/>
	<meta http-equiv="Content-Type" content="text/html"/>
	<meta http-equiv="X-UA-Compatible" content="IE=edge">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<meta name="description" content="fitcare">
	<meta name="author" content="Enmanuelle Acuña & Jose Alexander González">

	<title>@ViewData["Title"] - fitcare</title>

	<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
	<link rel="stylesheet" href="~/css/site.css"/>
	<link rel="stylesheet" href="~/lib/font-awesome/css/all.min.css"/>
</head>

<body>
<header>
	<nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm">
		<div class="container my-1">
			<button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarNav"
			        aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
				<span class="navbar-toggler-icon"></span>
			</button>
			<div class="collapse navbar-collapse" id="navbarNav">
				<ul class="navbar-nav mr-auto">
					<li class="nav-item">
						<a class="navbar-brand" asp-action="Admin" asp-controller="Home">
							<img src="~/images/fitcare_logo_32.png" height="18" alt="fitcare" loading="lazy">
						</a>
					</li>

					<li class="nav-item pt-1">
						<a class="nav-link font-weight-bold text-primary" href='@Url.Action("AcercaDe", "Home")'>
							Acerca de
						</a>
					</li>
				</ul>

				<ul class="navbar-nav">
					@if (SignInManager.IsSignedIn(User))
					{
						<li class="nav-item pt-1">
							<div>
								<form class="form-inline" asp-controller="Cuentas" asp-action="CerrarSesion"
								      asp-route-returnUrl="@Url.Action("IniciarSesion", "Cuentas")">
									<button type="submit" class="dropdown-item text-danger font-weight-bold">
										Cerrar sesión
									</button>
								</form>
							</div>
						</li>
					}
				</ul>
			</div>
		</div>
	</nav>
</header>

<!-- Toast Container -->
<div aria-live="polite" aria-atomic="true" style="position: fixed; top: 70px; right: 20px; z-index: 9999;">
	<div id="toastContainer"></div>
</div>

<div class="mt-4 body-content">
	@RenderBody()
</div>

<footer>
	<div class="container mt-4 text-center">
		<small>&copy; @DateTime.Now.Year - fitcare</small>
	</div>
</footer>

<script type="text/javascript" src="~/lib/jquery/dist/jquery.min.js"></script>
<script type="text/javascript" src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script type="text/javascript" src="~/js/site.js" asp-append-version="true"></script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>

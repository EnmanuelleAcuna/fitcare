@model AgregarMaquinaViewModel

@{
    ViewBag.Title = "Máquinas";
}

<div class="container">
    <div class="row">
        <div class="col-5 align-self-center">
            <h6 class="page-title">Agregar máquina</h6>
        </div>
        <div class="col-7 align-self-center">
            <div class="d-flex align-items-center justify-content-end">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item">
                            <a asp-action="Admin" asp-controller="Home">Administración</a>
                        </li>
                        <li class="breadcrumb-item">
                            <a asp-action="Maquinas">Máquinas</a>
                        </li>
                        <li class="breadcrumb-item active" aria-current="page">
                            Agregar
                        </li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-body">
                    <form asp-action="AgregarMaquina" asp-controller="Maquinas" method="post" autocomplete="off" enctype="multipart/form-data">
                        <div class="row">
                            <div class="col-md-12">
                                <div asp-validation-summary="ModelOnly"></div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-sm-12 col-md-4">
                                <div class="form-group">
                                    <label asp-for="Codigo"></label>
                                    <input asp-for="Codigo" class="form-control form-control-sm" placeholder="Digite el código de la máquina" />
                                    <span asp-validation-for="Codigo" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-sm-12 col-md-4">
                                <div class="form-group">
                                    <label asp-for="Nombre"></label>
                                    <input asp-for="Nombre" class="form-control form-control-sm" placeholder="Digite el nombre de la máquina" />
                                    <span asp-validation-for="Nombre" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-sm-12 col-md-4">
                                <div class="form-group">
                                    <label asp-for="CodigoActivo"></label>
                                    <input asp-for="CodigoActivo" class="form-control form-control-sm" placeholder="Digite el número de activo de la máquina" />
                                    <span asp-validation-for="CodigoActivo" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-sm-12 col-md-4">
                                <div class="form-group">
                                    <label asp-for="IdTipoMaquina"></label>
                                    <select asp-for="IdTipoMaquina" asp-items="@(new List<SelectListItem>(ViewBag.ListaTiposMaquina))" class="form-control form-control-sm">
                                        <option value="">Seleccione el tipo de máquina</option>
                                    </select>
                                    <span asp-validation-for="IdTipoMaquina"></span>
                                </div>
                            </div>

                            <div class="col-sm-12 col-md-4">
                                <div class="form-group">
                                    <label asp-for="FechaAdquisicion"></label>
                                    <br />
                                    <input asp-for="FechaAdquisicion" class="form-control form-control-sm" />
                                    <span asp-validation-for="FechaAdquisicion" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-sm-12 col-md-4">
                                <div class="form-group">
                                    <label asp-for="Activo"></label>
                                    <br />
                                    <input asp-for="Activo" type="checkbox" />
                                </div>
                            </div>
                        </div>

                        <div class="row mt-2">
                            <div class="col-12">
                                <button type="submit" class="btn btn-sm btn-primary">Guardar</button>
                                <a asp-action="Maquinas" class="btn btn-sm btn-secondary">Regresar</a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

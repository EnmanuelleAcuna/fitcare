@model IEnumerable<TipoMaquinaViewModel>

@{
	ViewBag.Title = "Tipos de máquina";
}

<div class="container">
	<div class="row">
		<div class="col-5 align-self-center">
			<h6 class="page-title">Lista de tipos de máquina</h6>
		</div>
		<div class="col-7 align-self-center">
			<div class="d-flex align-items-center justify-content-end">
				<nav aria-label="breadcrumb">
					<ol class="breadcrumb">
						<li class="breadcrumb-item">
							<a asp-action="Admin" asp-controller="Home">Administración</a>
						</li>
						<li class="breadcrumb-item active" aria-current="page">
							Tipos de máquina
						</li>
					</ol>
				</nav>
			</div>
		</div>
	</div>

	<div class="row">
		<div class="col-12">
			<div class="card shadow-sm">
				<div class="card-body">
					<a asp-action="AgregarTipoMaquina" class="btn btn-sm btn-primary">Agregar</a>

					<hr />

					<div class="table-responsive">
						<table class="table table-hover table-sm text-nowrap">
							<thead>
							<tr>
								<th>@Html.DisplayNameFor(m => m.FirstOrDefault().Codigo)</th>
								<th>@Html.DisplayNameFor(m => m.FirstOrDefault().Nombre)</th>
								<th>@Html.DisplayNameFor(m => m.FirstOrDefault().Estado)</th>
								<th class="text-right"></th>
							</tr>
							</thead>
							<tbody>
								@foreach (var TipoMaquina in Model)
								{
									<tr>
										<td>@TipoMaquina.Codigo</td>
										<td>@TipoMaquina.Nombre</td>
										<td>@TipoMaquina.Estado</td>
										<td class="text-right">
											<div class="btn-group btn-group-sm" role="group" aria-label="Basic example">
												<button id="BtnDetalle" class="btn btn-sm btn-light text-primary" data-toggle="modal" data-target="#ModalDetalle"
													data-idtipomaquina="@TipoMaquina.IdTipoMaquina">Detalle</button>
												<a class="btn btn-sm btn-light" asp-controller="Maquinas" asp-action="EditarTipoMaquina"
													asp-route-id="@TipoMaquina.IdTipoMaquina">Modificar</a>
											</div>
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

<partial name="_DetalleTipoMaquina" />

@section Scripts {
	<script type="text/javascript">
		$(document).ready(function () {
			mostrarNotificacion('@TempData["ToastMessage"]', '@TempData["ToastType"]');
		});

		$('#ModalDetalle').on('show.bs.modal', function (event)
		{
			var button = $(event.relatedTarget);
			var IdTipoMaquina = button.data('idtipomaquina');

			$("#ModalDetalle").find('.modal-title .nombre').text("Cargando...");

			$.ajax({
				url: '@Url.Action("DetalleTipoMaquina")',
				data: { Id: IdTipoMaquina },
				dataType: "json",
				type: 'GET',
				success: handleData,
				error: handleError
			});
		});

		function handleData(data)
		{
			var modal = $("#ModalDetalle");
			modal.find('.modal-title .nombre').text(data.nombre);
			modal.find('.modal-body .estado').text(data.estado);
			modal.find('.modal-body .codigo').text(data.codigo);
			modal.find('.modal-body .creado-por').text(data.creadoPor);
			modal.find('.modal-body .creado-el').text(data.creadoEl);
			modal.find('.modal-body .modificado-por').text(data.editadoPor);
			modal.find('.modal-body .modificado-el').text(data.editadoEl);
		}

		function handleError()
		{
			var modal = $("#ModalDetalle");
			modal.find('.modal-title .nombre').text("Error al obtener la información");
			modal.find('.modal-body .estado').text('N/A');
			modal.find('.modal-body .codigo').text('N/A');
			modal.find('.modal-body .creado-por').text('N/A');
			modal.find('.modal-body .creado-el').text('N/A');
			modal.find('.modal-body .modificado-por').text('N/A');
			modal.find('.modal-body .modificado-el').text('N/A');
		}
	</script>
}
